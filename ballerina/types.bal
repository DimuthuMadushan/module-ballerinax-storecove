"|"XWP"|"XWQ"|"XWR"|"XWS"|"XWT"|"XWU"|"XWV"|"XWW"|"XWX"|"XWY"|"XWZ"|"XXA"|"XXB"|"XXC"|"XXD"|"XXF"|"XXG"|"XXH"|"XXJ"|"XXK"|"XYA"|"XYB"|"XYC"|"XYD"|"XYF"|"XYG"|"XYH"|"XYJ"|"XYK"|"XYL"|"XYM"|"XYN"|"XYP"|"XYQ"|"XYR"|"XYS"|"XYT"|"XYV"|"XYW"|"XYX"|"XYY"|"XYZ"|"XZA"|"XZB"|"XZC"|"XZD"|"XZF"|"XZG"|"XZH"|"XZJ"|"XZK"|"XZL"|"XZM"|"XZN"|"XZP"|"XZQ"|"XZR"|"XZS"|"XZT"|"XZU"|"XZV"|"XZW"|"XZX"|"XZY"|"XZZ"|"04"|"05"|"08"|"16"|"17"|"18"|"19"|"26"|"29"|"30"|"31"|"32"|"36"|"43"|"44"|"45"|"46"|"47"|"48"|"53"|"54"|"62"|"63"|"64"|"66"|"69"|"71"|"72"|"73"|"76"|"78"|"84"|"90"|"92"|"93"|"94"|"95"|"96"|"97"|"98"|"1A"|"1B"|"1C"|"1D"|"1E"|"1F"|"1G"|"1H"|"1J"|"1K"|"1L"|"1M"|"1X"|"2V"|"2W"|"3E"|"3G"|"3H"|"3I"|"4A"|"4B"|"4E"|"5C"|"5F"|"5G"|"5H"|"5I"|"5K"|"5P"|"5Q"|"A1"|"A25"|"A50"|"A51"|"A52"|"A57"|"A58"|"A60"|"A61"|"A62"|"A63"|"A64"|"A65"|"A66"|"A67"|"A77"|"A78"|"A79"|"A80"|"A81"|"A82"|"A83"|"AJ"|"AM"|"AP"|"AR"|"ARE"|"ATT"|"AV"|"AW"|"B0"|"B2"|"B36"|"B37"|"B38"|"B39"|"B40"|"B5"|"B51"|"B6"|"B65"|"B9"|"BD"|"BE"|"BG"|"BH"|"BJ"|"BK"|"BL"|"BO"|"BR"|"BT"|"BW"|"BX"|"BZ"|"C1"|"C2"|"C4"|"C5"|"C6"|"C77"|"C98"|"CA"|"CH"|"CJ"|"CK"|"CL"|"CO"|"CQ"|"CR"|"CS"|"CT"|"CU"|"CV"|"CY"|"CZ"|"D14"|"D28"|"D35"|"D37"|"D38"|"D39"|"D40"|"D64"|"D66"|"D67"|"D7"|"D70"|"D71"|"D72"|"D75"|"D76"|"D79"|"D8"|"D9"|"D90"|"D92"|"D96"|"D97"|"D98"|"D99"|"DC"|"DE"|"DI"|"DQ"|"DR"|"DRM"|"DS"|"DU"|"DX"|"DY"|"E2"|"E3"|"E5"|"EC"|"EP"|"EV"|"F1"|"F9"|"FB"|"FD"|"FE"|"FG"|"FM"|"G7"|"GC"|"GD"|"GH"|"GK"|"GN"|"GRT"|"GT"|"GW"|"GY"|"GZ"|"H1"|"H2"|"HAR"|"HD"|"HE"|"HF"|"HI"|"HJ"|"HK"|"HL"|"HN"|"HO"|"HP"|"HS"|"HT"|"HY"|"IC"|"IF"|"II"|"IL"|"IM"|"IP"|"IT"|"JB"|"JG"|"JO"|"JR"|"K5"|"KD"|"KF"|"KG"|"KS"|"KTM"|"LC"|"LE"|"LI"|"LJ"|"LX"|"M0"|"MA"|"MF"|"MK"|"MQ"|"MT"|"MV"|"N2"|"NB"|"NBB"|"NC"|"ND"|"NE"|"NG"|"NH"|"NI"|"NJ"|"NN"|"NPL"|"NPR"|"NQ"|"NR"|"NRL"|"NTT"|"NV"|"NY"|"OP"|"OZ"|"P0"|"P3"|"P4"|"P6"|"P7"|"P8"|"P9"|"PA"|"PB"|"PE"|"PF"|"PG"|"PK"|"PL"|"PM"|"PN"|"PT"|"PU"|"PV"|"PW"|"PY"|"PZ"|"QD"|"QH"|"QK"|"QT"|"R4"|"RA"|"RD"|"RG"|"RK"|"RL"|"RN"|"RO"|"RS"|"RU"|"S5"|"S6"|"S7"|"S8"|"SA"|"SD"|"SE"|"SHT"|"SK"|"SL"|"SN"|"SO"|"SP"|"SS"|"SST"|"ST"|"SV"|"T1"|"T4"|"T5"|"T6"|"T7"|"T8"|"TA"|"TC"|"TD"|"TE"|"TF"|"TJ"|"TK"|"TL"|"TN"|"TQ"|"TR"|"TS"|"TSD"|"TSH"|"TT"|"TU"|"TV"|"TW"|"TY"|"UA"|"UD"|"UE"|"UF"|"UH"|"UM"|"VI"|"VQ"|"VS"|"W4"|"WH"|"WI"|"WR"|"WW"|"YL"|"YT"|"Z1"|"Z2"|"Z3"|"Z4"|"Z5"|"Z6"|"Z8" quantityUnitCode = "C62";
    # An identifier for the production lot which the line items come from
    OrderLineLotNumberIdsItemsString[] lotNumberIds?;
    # An array of allowance charges
    LineAllowanceCharge[] allowanceCharges?;
    # The number of items the price is for
    decimal baseQuantity?;
    # A short name for this line
    @constraint:String {maxLength: 255, minLength: 1}
    string name?;
    # The price per item (may be fractional)
    decimal itemPrice?;
    # Whether or not the line items must be delivered in a single shipment
    boolean allowPartialDelivery = false;
    # An array of taxes, duties and fees for this invoice line. Multiple taxesDutiesFees items is allowed only for IN (India) and US (USA) taxes. All other countries can only have a single Tax item in this array
    Tax[] taxesDutiesFees?;
};

# The invoice response to send or received
public type DocumentInvoiceResponse record {
    # A note to add to the invoice reponse
    string note?;
    # A list of clarifications why a received invoice was rejected (RE), under query (UQ) or partially approved (CA), and what action to take. For responses CA, UQ and RE, at least one clarification with a clarificationCode is required. For invoices received through the French (fr-dgfip) workflow, at least one of them must have clarificationCodeType OPStatusReason
    InvoiceResponseClarification[] clarifications?;
    # The identifier of the Invoice Response / ApplicationResponse document (UBL cbc:ID). Present on received responses in document_submission webhooks (acknowledged, in_process, and later buyer statuses). Not required when you send an invoice response
    string id?;
    # The date when the status became effective. Format: yyyy-mm-dd
    @constraint:String {pattern: re `^[0-9]{4}-[0-9]{2}-[0-9]{2}$`}
    string effectiveDate?;
    # The response code. For details see https://docs.peppol.eu/poacc/upgrade-3/codelist/UNCL4343-T111/. For invoices received through the French (fr-dgfip) workflow, Storecove delivers the response to the supplier over Peppol using the corresponding French lifecycle (CDV) status: AB/AP as 205 Approuvée, IP as 204 Prise en charge, CA as 206 Approuvée partiellement, UQ as 207 En litige, RE as 210 Refusée and PD as 211 Paiement transmis. Only RE (210 Refusée) is subsequently reported to the PPF; facultative statuses (204–207, 211) are Peppol-only and are never transmitted to the tax administration. See the France appendix for details
    "AB"|"IP"|"UQ"|"CA"|"RE"|"AP"|"PD" responseCode;
};

# DEPRECATED. Use RawDocumentData. The invoice to send, in base64 encoded format. Provide either invoice, or invoiceData, but not both
public type InvoiceData record {
    # How to interpret the document
    "ubl"|"cii"|"idoc"|"setu14" conversionStrategy?;
    # The base64 encoded version of the document
    @constraint:String {minLength: 5}
    string document?;
};

# The document to send
public type SendableDocument record {
    # The invoice report to send. Reports a received invoice (forDocumentGuid) to the tax authority as a purchase, reusing the data of the received invoice.
    # ++++
    # <p>For SG (IRAS) the received invoice is reported on the payables profile, so every GST category on it is converted to its purchase invoice code (see the SG table in Tax). Received invoices can be reported with invoice_report when every GST category is either one of the sales categories standard (SR), outside_scope (OS), zero_rated (ZR), not_registered (NG), not_applicable (NA), srca_c (SRCA-C), regulation33_exempt (ES33) and nonregulation33_exempt (ESN33), which are converted, or already a purchase category (the purchase invoice column of the SG table, for example TXCA or EP on an invoice received via the API), which is kept as is. Received invoices that contain deemed_supply (DS), srlvg (SRLVG), srovr_rs (SROVR-RS), srovr_lvg (SROVR-LVG), srca_s (SRCA-S) or export are rejected with a 422 on forDocumentGuid; report those as a self-billing invoice (documentType invoice with selfBillingMode true) using the purchase GST categories.</p>
    # ++++
    DocumentInvoiceReport invoiceReport?;
    # The invoice response to send or received
    DocumentInvoiceResponse invoiceResponse?;
    # E-reporting payload for France (DGFiP). Send with document.documentType "fr_e_report". The platform submits the report (FFE1025A) in the fr-dgfip workflow. Both camelCase frEReport and snake fr_e_report keys are accepted in the request body; the public schema uses frEReport. G6.29: exactly one of transactionReport (TB-2) or paymentReport (TB-3) must be present — not both, not neither (enforced at submission time; not expressible in OpenAPI 2.0). See also the France appendix in the API documentation
    FrEReport frEReport?;
    # The type of document to be sent
    "enveloped_data"|"invoice"|"invoice_response"|"cdar"|"ppf_cdar"|"invoice_report"|"order"|"fr_e_report"|"payment_received_notification" documentType;
    # A document to send, in base64 encoded format
    RawDocumentData rawDocumentData?;
    # The invoice to send. Provide either invoice, or invoiceData, but not both
    Invoice invoice?;
    # A French payment received notification (lifecycle status 212 Encaissee). Provide the referenced invoice submission via the top-level forDocumentSubmissionGuid field. Use mode=auto when the invoice was paid in full: the per-VAT-rate breakdown is derived from the referenced invoice. Use mode=manual for a partial payment: you supply the amounts actually received per VAT rate, since only you know how the payment was allocated
    SendableDocumentPaymentReceivedNotification paymentReceivedNotification?;
    # A document to send, in base64 encoded format, to be wrapped in an envelope
    EnvelopedData envelopedData?;
    # The order to send
    DocumentOrder 'order?;
};

public type DgfipAnnuaire record {
    # Human-readable label for the routing code (annuaire central libelleCodeRoutage). Mandatory when the identifier carries a routing code
    @jsondata:Name {value: "routing_code_label"}
    string routingCodeLabel?;
    DgfipAnnuaireAddress address?;
    # Planned start date (dateDebutEffet) for the annuaire line. Defaults to today + 1 day (annuaire central rule G1.87)
    @jsondata:Name {value: "start_date"}
    string startDate?;
};

public type NetworkSpecification record {
    # A network to advertise the identifier on
    "peppol"|"dbnalliance"|"dgfip" name?;
    # A list of sub_networks to advertise documents for. The Peppol network has two sub_networks: "france" (for the upcoming French reform) and "eb2b" (enhanced B2B). Use "main" to advertise on the main Peppol network
    @jsondata:Name {value: "sub_networks"}
    ("main"|"france"|"eb2b")[] subNetworks?;
    DgfipAnnuaire annuaire?;
};

# A party that can receive or send invoices
public type ReceiverParty Party;

public type PurchaseInvoiceInvoiceLineItem record {
    # The quantity of the item. Can have up to digits
    decimal quantity?;
    # The unit code of the quantity
    @jsondata:Name {value: "unit_code"}
    string unitCode?;
};

public type CorpPass record {
    # The name of the person who is going to perform the CorpPass process
    @jsondata:Name {value: "signer_name"}
    string signerName?;
    # The URL the CorpPass system will redirect to in case of successful identity verfication
    @jsondata:Name {value: "client_redirect_success_url"}
    string clientRedirectSuccessUrl?;
    # The CorpPass flow type
    @jsondata:Name {value: "flow_type"}
    "corppass_flow_redirect"|"corppass_flow_email"|"corppass_flow_pdf" flowType?;
    # Whether or not CorpPass is being simulated
    @jsondata:Name {value: "simulate_corppass"}
    boolean simulateCorppass = false;
    # The URL the CorpPass system will redirect to in case of a failure to perform identity verfication
    @jsondata:Name {value: "client_redirect_fail_url"}
    string clientRedirectFailUrl?;
    # The CorpPass redirect URL
    @jsondata:Name {value: "corppass_url"}
    string corppassUrl?;
    # The email of the person who is going to perform the CorpPass process
    @jsondata:Name {value: "signer_email"}
    string signerEmail?;
    # Whether or not the CorpPass flow is enabled
    boolean enabled = false;
    # The status of the CorpPass process
    "corppass_no_status"|"corppass_initiated"|"corppass_cancelled"|"corppass_failed"|"corppass_succeeded" status?;
};

public type Administration record {
    # The id of the SenderEmailIdentity. If not provided, the Storecove default sender will be used
    @jsondata:Name {value: "sender_email_identity_id"}
    int senderEmailIdentityId?;
    # The LegalEntity the Administration belongs to
    @jsondata:Name {value: "legal_entity_id"}
    int legalEntityId?;
    # The version of the package
    @jsondata:Name {value: "package_version"}
    "peppol_bis_v3"|"aunz"|"sg" packageVersion?;
    # How to package the purchase invoice
    "ubl" packaging?;
    # The Storecove assigned id for the Administration
    int id?;
    # The email address to send the received document to
    @constraint:String {maxLength: 128, minLength: 5}
    string email?;
};

public type DeliveryTerms record {
    # A description of special conditions relating to the delivery terms
    @constraint:String {maxLength: 512}
    string specialTerms?;
    # The incoterms:
    # ++++
    # <ul>    <li>        <strong>EXW – Ex Works</strong><br/>        The seller must give the buyer access to goods at an agreed location. From that moment, the buyer bears almost all costs and risks during the entire shipping process.<br/>    </li>    <li>        <strong>FCA – Free Carrier</strong><br/>        The seller must make the goods available at his own risk and expense at his own premises or at an agreed place. In both cases, the seller is responsible for the clearance of the goods for export. It can be agreed that the buyer must instruct the carrier to transfer a “Bill of Lading (BL)” with a note on board to the seller.    </li>    <li>        <strong>CPT – Carriage Paid To</strong><br/>        The seller has the same responsibilities as with FCA, but in this case also pays the delivery costs.    </li>    <li>        <strong>CIP – Carriage Insurance Paid To</strong><br/>        The same seller responsibilities as with CPT, only in this case the seller is obliged to pay the insurance with a high coverage ratio. Parties can agree separately to apply limited coverage.    </li>    <li>        <strong>DAP – Delivered At Place</strong><br/>        The seller bears the costs and risks during the transport of the goods to an agreed address. As soon as the goods have arrived at this address and are ready for unloading, the risk passes to the buyer.    </li>    <li>        <strong>DPU – Delivered at Place Unloaded</strong><br/>        The seller is responsible for the costs and risks of delivering goods to an agreed destination where goods can be unloaded for further transport. The selling party arranges customs and unloads the goods at the agreed place. The buyer arranges the customs clearance and any associated rights.    </li>    <li>        <strong>DDP – Delivered Duty Paid</strong><br/>        The seller bears the costs and risks of transport, carries out the export and import responsibilities and pays any import duties. As soon as the goods have arrived at the address and are ready for unloading, the risk passes to the buyer.    </li>    <li>        <strong>FAS – Free Alongside Ship</strong><br/>        The seller bears all costs and risks until the goods are delivered next to the ship. From that point, the risk is for the buyer and he also arranges the export clearance and import clearance.    </li>    <li>        <strong>FOB – Free On Board</strong><br/>        The seller bears all costs and risks until the goods are on board the ship and also arranges the export clearance. As soon as the goods have been delivered to the ship, the buyer bears all responsibilities.    </li>    <li>        <strong>CFR – Cost And Freight</strong><br/>        The same applies to the seller and buyer as with FOB, but in this case, the seller must also pay for the transport of the goods to the port.    </li>    <li>        <strong>CIF – Cost, Insurance, and Freight</strong><br/>        The seller has the same obligations as with CFR but also pays the (minimum) insurance costs. The buyer must pay for more comprehensive insurance.    </li></ul>
    # ++++
    "EXW"|"FCA"|"CPT"|"CIP"|"DAP"|"DPU"|"DDP"|"FAS"|"FOB"|"CFR"|"CIF" incoterms?;
    # The location to which the delivery terms refer
    @constraint:String {maxLength: 128}
    string deliveryLocationId?;
};

# The result of a document submission
public type DocumentSubmissionResult record {
    # A (V4) GUID for the document submission
    string guid?;
};

# A reference to a document
public type Reference record {
    # A description for the referenced document
    @constraint:String {maxLength: 1024, minLength: 2}
    string documentDescription?;
    # The type of the referenced document. The following types are supported:
    # ++++
    # <ul>    <li>        <b>purchase_order</b> (document level, Invoice)        <p>A reference to an order for this document, assigned by the buyer. Note that this often is a key field, since many receivers of invoices will use this field to automatically match the invoice to an order they placed. Many receivers refuse invoices that cannot be automatically matched, in particular government agencies. So it is highly recommended to fill this field whenever possible.</p>    </li>    <li>        <b>billing</b> (document level, Invoice)        <p>A reference to a billing document. For instance, credit notes may refer to an invoice they are a credit note for.</p>    </li>    <li>        <b>billing_uuid</b> (document level, Invoice)        <p>DEPRECATED. Use the billingUuid property of the 'billing' reference. A UUID reference to a billing document. For instance, credit notes may refer to an invoice they are a credit note for.</p>    </li>    <li>        <b>advance_invoice</b> (document level, Invoice)        <p>A reference to an advance invoice that a settlement invoice settles. Used for Polish KSeF settlement invoices (faktura rozliczeniowa, ROZ), with one entry per advance invoice (FakturaZaliczkowa). When sending, provide documentId set to the advance invoice's KSeF number when available or otherwise the seller invoice number. When receiving, one entry is emitted per FakturaZaliczkowa, with documentId set to the KSeF number when available (also kept in documentUuid) or otherwise the seller invoice number.</p>    </li>    <li>        <b>sales_order</b> (document level, Invoice + Order)        <p>A reference to an order for this document, assigned by the seller.</p>    </li>    <li>        <b>buyer_reference</b> (document level, Invoice, Order)        <p>The buyer's reference. Used for internal routing by the receiver. For orders, this becomes the customer reference which the receiver of the order should put back in the buyer reference field in the invoice.</p>    </li>    <li>        <b>additional</b> (document level, Invoice, Order)        <p>An additional reference. For UBL, this translates into an AdditionalDocumentReference without a EmbeddedDocumentBinaryObject. For the latter, use the attachments array.</p>    </li>    <li>        <b>contract</b> (document level, Invoice + Order)        <p>A reference to a contract or framework agreement that this document relates to.</p>    </li>    <li>        <b>despatch_advice</b> (document level, Invoice)        <p>A reference to a despatch advice for this document. In the FatturaPA, this is what will become the DDT.</p>    </li>    <li>        <b>originator</b> (document level, Invoice + Order)        <p>A reference to an originator document for this invoice.</p>    </li>    <li>        <b>receipt</b> (document level, Invoice)        <p>A reference to a receipt document for this document.</p>    </li>    <li>        <b>project</b> (document level, Invoice)        <p>A reference to a project document for this document.</p>    </li>    <li>        <b>quotation</b> (document level, Order)        <p>A reference to a quotation document for this document.</p>    </li>    <li>        <b>replaced_order</b> (document level, Order)        <p>A reference to the initial order that was rejected and a new order is issued.        </p>    </li>    <li>        <b>payment_url</b> (document level, Invoice)        <p>A to a payment URL for the invoice.</p>    </li>    <li>        <b>item_classification_code</b> (line level)        <p>A reference to a commodity classification / item classification code for this line. Note that in combination with the documentIdListId these can be used for Malaysia LHDNM to provide the product classification code (documentIdListId=CLASS) and the product tariff code (documentIdListId=PTC)</p>    </li>    <li>        <b>item_commodity_code</b> (line level)        <p>A reference to a commodity classification / commodity code for this line.</p>    </li>    <li>        <b>item_specification</b> (line level)        <p>A referece to an item specification document</p>    </li>    <li>        <b>line_document_reference</b> (line level)        <p>A reference to another document for this line.</p>    </li>    <li>        <b>line_standard_item_identification</b> (line level)        <p>A standard item identification.</p>    </li>    <li>        <b>line_sellers_item_identification</b> (line level)        <p>The seller's item identification.</p>    </li>    <li>        <b>line_buyers_item_identification</b> (line level)        <p>The buyer's item identification.</p>    </li>    <li>        <b>line_purchase_order</b> (line level)        <p>A reference to an order for this line, assigned by the buyer. Note not all outgoing document formats support this, so they may end up concatenated at the invoice level.</p>    </li>    <li>        <b>line_billing</b> (line level)        <p>A reference to a previous invoice that this invoice line corrects (FR-FE EXT-FR-FE-136/137/138/139). Use documentId for the previous invoice number, documentTypeCode for the type code, issueDate for the previous invoice issue date and lineId for the line in the previous invoice.</p>    </li>    <li>        <b>line_despatch_document</b> (line level)        <p>A reference to a despatch document (BL) for this invoice line (FR-FE). Use documentId for the despatch document identifier and lineId for the line in the despatch document. In UBL the documentId is taken from Invoice/InvoiceLine/DespatchLineReference/DocumentReference/ID with Invoice/DespatchDocumentReference/ID as fallback. In CII the documentId is taken from IncludedSupplyChainTradeLineItem/SpecifiedLineTradeDelivery/DespatchAdviceReferencedDocument/IssuerAssignedID with ApplicableHeaderTradeDelivery/DespatchAdviceReferencedDocument/IssuerAssignedID as fallback.</p>    </li>    <li>        <b>line_receipt_document</b> (line level)        <p>A reference to a receipt document (BR) for this invoice line (FR-FE). Use documentId for the receipt document identifier and lineId for the line in the receipt document. In UBL the documentId is taken from Invoice/InvoiceLine/ReceiptLineReference/DocumentReference/ID with Invoice/ReceiptDocumentReference/ID as fallback. In CII the documentId is taken from IncludedSupplyChainTradeLineItem/SpecifiedLineTradeDelivery/ReceivingAdviceReferencedDocument/IssuerAssignedID with ApplicableHeaderTradeDelivery/ReceivingAdviceReferencedDocument/IssuerAssignedID as fallback.</p>    </li></ul>
    # ++++
    "purchase_order"|"replaced_order"|"buyer_reference"|"billing"|"billing_uuid"|"advance_invoice"|"sales_order"|"contract"|"despatch_advice"|"originator"|"receipt"|"project"|"quotation"|"payment_url"|"additional"|"certified_exporter_authorization"|"free_trade_agreement"|"my_customs_form_1_9"|"my_customs_form_2"|"item_classification_code"|"item_commodity_code"|"item_specification"|"line_document_reference"|"line_standard_item_identification"|"line_sellers_item_identification"|"line_buyers_item_identification"|"line_purchase_order"|"line_billing"|"line_despatch_document"|"line_receipt_document" documentType;
    # The UUID of the referenced document
    string documentUuid?;
    # The version id of the list id of the id of the referenced document
    string documentIdListVersionId?;
    # The list id of the id of the referenced document
    string documentIdListId?;
    # The line in the referenced document
    string lineId?;
    # The version id of the scheme id of the id of the referenced document
    string documentIdSchemeVersionId?;
    # The scheme id of the id of the referenced document
    string documentIdSchemeId?;
    # The the agency id of the scheme id of the id of the referenced document
    string documentIdSchemeAgencyId?;
    # The agency id of the list id of the id of the referenced document
    string documentIdListAgencyId?;
    # The code of the referenced document type. Used for documentType = 'line_document_reference', and for the FR-FE extensions documentType = 'contract' (EXT-FR-FE-01, allowed values for FR-DGFiP: 'CONTRAT', 'MARCHE') and documentType = 'line_billing' (EXT-FR-FE-137). UNCL1001 codes may be sent either prefixed ('uncl1001_<code>') or as bare digits
    @constraint:String {pattern: re `^(uncl1001_[0-9]{1,3}|[0-9]{1,3}|CONTRAT|MARCHE)$`}
    string documentTypeCode?;
    # The id of the referenced document
    string documentId?;
    # The issue date of the referenced document
    @constraint:String {pattern: re `^[0-9]{4}-[0-9]{2}-[0-9]{2}$`}
    string issueDate?;
};

# The different ways to send the invoice to the recipient. The publicIdentifiers are used to send via the Peppol network, if the recipient is not registered on the Peppol network, the invoice will be sent to the email addresses in the emails property. This property is only mandatory when sending the invoice data using the <<_openapi_invoice>> property, not when sending using the <<_openapi_invoicedata>> property, in which case this information will be extracted from the <<_openapi_invoicedata>> object. If you do specify an <<_openapi_invoicerecipient>> object and an <<_openapi_invoicedata>> object, the data from the two will be merged
public type Routing record {
    # The email addresses the invoice should be sent to if none of the other identifiers can be used
    string[] emails?;
    # A list of electronic routing identifiers. These are the identifiers used on the Peppol network or for other destinations
    ElectronicIdentifiers eIdentifiers?;
    # If you wish to send the document yourself in a Y-flow, use this flag. Wait for the 'cleared' webhook and use the <<_openapi_show_document_submission_evidence>> endpoint to retrieve the clearing evidence. This will include a sendable document
    boolean clearWithoutSending = false;
    # Any additional networks to consider for routing
    @constraint:Array {minLength: 1}
    RoutingNetwork[] networks?;
};

# Payment-report aggregate for B2C: the platform uses `date` and `taxSubtotal` to build the submitted report. Put `currency` and per-rate amounts on each `taxSubtotal` line; a top-level `currency` (if present) is not used for the France payment XML. Do not use the B2C *transaction* aggregate field set here (`vatPaymentOption`, `category`, `amountExcludingVat`, `amountIncludingVat`, `transactionsCount`, transaction-style `taxSubtotals`); those are only for `b2cTransactions` rows
public type FrEReportB2cPayment record {
    # Format: yyyy-mm-dd.
    @constraint:String {pattern: re `^[0-9]{4}-[0-9]{2}-[0-9]{2}$`}
    string date?;
    # Optional. Not read by the payment-aggregate mapping; set `currency` on each `taxSubtotal` row for output.
    string currency?;
    record {}[] taxSubtotal?;
};

# The C5 deactivation request
public type C5DeactivationRequest record {
    # The URL to redirect to in case of a C5 authorization success
    @jsondata:Name {value: "client_redirect_success_url"}
    string clientRedirectSuccessUrl;
    # The identifier
    string identifier;
    # The flow type
    @jsondata:Name {value: "flow_type"}
    "flow_redirect" flowType;
    # The scheme
    "SG:UEN" scheme;
    # The URL to redirect to in case of a C5 authorization fail
    @jsondata:Name {value: "client_redirect_fail_url"}
    string clientRedirectFailUrl;
    # The superscheme of the identifier. Should always be 'iso6523-actorid-upis'
    "iso6523-actorid-upis" superscheme;
    # Whether to simulate the C5 deactivation
    boolean simulate;
};

# The buyer sending the order
public type BuyerCustomerPartyOrder record {
    # A party that can send documents
    SenderParty party;
};

# A flag to filter for documents
public type DiscoveryFlag record {
    # Whether or not to filter for documents that support self billing
    "allowed"|"required"|"not_allowed" supportsSelfBilling = "not_allowed";
};

# The result of an invoice submission
public type InvoiceSubmissionResult record {
    # A (V4) GUID for the invoice submission
    string guid?;
};

# Settings for an additional routing network
public type NetworkSettings record {
    # Whether or not the network is enabled
    boolean scheme?;
    # Whether or not to mock the network, if possible
    boolean mock = false;
};

public type DgfipAnnuaireAddress record {
    # The zipcode
    @constraint:String {maxLength: 32}
    string zip?;
    # ISO 3166-1 alpha-2 country code
    @constraint:String {maxLength: 2, minLength: 2}
    string country?;
    # The city
    @constraint:String {maxLength: 64}
    string city?;
    # The first address line
    @constraint:String {maxLength: 192}
    string street1?;
    # The second address line, if applicable
    @constraint:String {maxLength: 192}
    string street2?;
};

public type FrEReportDeclarantParty record {
    # Legal name and address fields as used in e-reporting samples
    FrEReportParty party?;
    @constraint:Array {minLength: 1}
    PublicIdentifier[] publicIdentifiers;
};

# A French payment received notification (lifecycle status 212 Encaissee). Provide the referenced invoice submission via the top-level forDocumentSubmissionGuid field. Use mode=auto when the invoice was paid in full: the per-VAT-rate breakdown is derived from the referenced invoice. Use mode=manual for a partial payment: you supply the amounts actually received per VAT rate, since only you know how the payment was allocated
public type SendableDocumentPaymentReceivedNotification record {
    # auto: report the full invoiced amount, split per VAT rate from the referenced invoice. manual: report the taxSubtotals provided here
    "auto"|"manual" mode;
    # Only for mode=manual, where it is mandatory, and rejected with mode=auto. One entry per VAT rate the payment is allocated to. The sum of the amountIncludingVat may not exceed the total of the referenced invoice, nor, per VAT rate, what that invoice has at the rate. Each notification is checked on its own: what earlier notifications reported for the same invoice is not added up, so it is up to the sender not to report more than the invoice total overall
    @constraint:Array {minLength: 1}
    PaymentTaxSubtotal[] taxSubtotals?;
    # The ISO 4217 currency code
    CurrencyCode currency?;
    # Only for mode=manual, and rejected with mode=auto. The date the payment was received, used as the date of the 212 status. Format: yyyy-mm-dd. It may precede the invoice (a down payment) but not be in the future. Defaults to the submission date
    string paymentDate?;
};

# A clarification for why a received invoice was rejected (RE) or under query (UQ) and what action to take
public type InvoiceResponseClarification record {
    # The code for the clarification. It must be valid for the clarificationCodeType: reason codes (OPStatusReason) are NON, REF, LEG, REC, QUA, DEL, PRI, QTY, ITM, PAY, UNR, FIN, PPD and OTH; action codes (OPStatusAction) are NOA, PIN, NIN, CNF, CNP, CNA and OTH. PPD can only be used with responseCode PD, and PPD/OTH require a clarification text. For details see https://docs.peppol.eu/poacc/upgrade-3/codelist/OPStatusReason/ and https://docs.peppol.eu/poacc/upgrade-3/codelist/OPStatusAction/. For invoices received through the French (fr-dgfip) workflow, the reason code is mapped to the corresponding French CDAR motif (MDT-113) in the Peppol-delivered CDAR; for RE responses only, that motif is also reported to the PPF
    "NON"|"REF"|"LEG"|"REC"|"QUA"|"DEL"|"PRI"|"QTY"|"ITM"|"PAY"|"UNR"|"FIN"|"PPD"|"OTH"|"NOA"|"PIN"|"NIN"|"CNF"|"CNP"|"CNA" clarificationCode?;
    # A textual description of the clarification. Mandatory when clarificationCode is PPD or OTH
    string clarification?;
    # The type of the clarification: "OPStatusReason" for a status reason (why the invoice has this status), "OPStatusAction" for a requested action. The clarificationCode must belong to the code list of this type. For invoices received through the French (fr-dgfip) workflow this field is mandatory for every clarification that carries a clarificationCode, and responses CA, UQ and RE require at least one clarification of type OPStatusReason
    "OPStatusReason"|"OPStatusAction" clarificationCodeType?;
    # A list of conditions that triggered the error. This is only included for receiving in webhooks. You cannot currently send these conditions
    InvoiceResponseCondition[] conditions?;
};

# A document to send, in base64 encoded format, to be wrapped in an envelope
public type EnvelopedData record {
    # The process id scheme id of the document
    "cenbii-procid-ubl" processIdSchemeId;
    # Information for the envelope of the document
    Envelope envelope;
    # Metadata about the document, used in the UI and reporting
    Metadata metadata;
    # The application to use to send the document
    "peppol"|"dbnalliance" application;
    # The process id of the document
    string processId;
    # The base64 encoded version of the document
    @constraint:String {minLength: 5}
    string document;
    # The document type id of the document
    string documentId;
    # The document id scheme id of the document
    "busdox-docid-qns"|"peppol-doctype-wildcard"|"bdx-docid-qns" documentIdSchemeId;
};

public type PurchaseInvoiceUbl record {
    # The id of the LegalEntity the invoice was received for
    @jsondata:Name {value: "legal_entity_id"}
    int legalEntityId?;
    # Whether or not the document image (PDF) was generated by Storecove. If true, it means the invoice was received without any attachments and Storecove generated one for you. If false, the invoice will contain at least one attachment, which was received from the invoice sender
    @jsondata:Name {value: "system_generated_primary_image"}
    boolean systemGeneratedPrimaryImage?;
    # Used for accountants. The id you specified for the organization
    @jsondata:Name {value: "external_key"}
    string externalKey?;
    # The GUID of the invoice
    string guid?;
    # The tax system of the invoice. Either tax_line_percentages or tax_line_amounts. The first tax system means the invoice lines contain only the tax percentages and the tax amounts are included only in the tax subtotals at the invoice level and so are only calculated at the invoice level. The tax system tax_line_amounts means that in addition to the percentage, each invoice line also contains the tax amount. The tax subtotals at the invoice level are calculated as the sum of the tax of the invoice lines. The distinction between the two tax systems has has implications for rounding
    @jsondata:Name {value: "tax_system"}
    string taxSystem?;
    # The Base64 encoded UBL invoice
    string ubl?;
    # Used for the embedded portal retrieval service. The external_user_id you provided when the ShopAccount was created
    @jsondata:Name {value: "external_user_id"}
    string externalUserId?;
};

public type AdministrationCreate record {
    # The id of the SenderEmailIdentity. If not provided, the Storecove default sender will be used
    @jsondata:Name {value: "sender_email_identity_id"}
    int senderEmailIdentityId?;
    # The LegalEntity the Administration belongs to
    @jsondata:Name {value: "legal_entity_id"}
    int legalEntityId?;
    # The version of the package
    @jsondata:Name {value: "package_version"}
    "peppol_bis_v3"|"aunz"|"sg" packageVersion = "peppol_bis_v3";
    # How to package the purchase invoice
    "ubl" packaging = "ubl";
    # The email address to send the received document to
    @constraint:String {maxLength: 128, minLength: 5}
    string email?;
};

public type AllowanceCharge record {
    # DEPRECATED. Use amountExcludingTax. The amount for the allowance or charge, excluding VAT
    decimal amountExcludingVat?;
    # The reason for the allowance or charge, free text. Defaults to 'Mutually Agreed' if neither reason nor reasonCode are provided
    string reason?;
    # Coded reason (VATEX code) explaining why the tax on this allowance or charge is exempt or zero-rated. Used for the French e-invoicing reform (FR-FE EXT-FR-FE-188/190). Maps to UBL AllowanceCharge/TaxCategory/TaxExemptionReasonCode and CII SpecifiedTradeAllowanceCharge/CategoryTradeTax/ExemptionReasonCode
    string taxExemptionReasonCode?;
    # The amount for the allowance or charge, excluding tax
    decimal amountExcludingTax?;
    # The base amount for the allowance or charge, including tax
    decimal baseAmountIncludingTax?;
    Tax tax?;
    # Free-text reason explaining why the tax on this allowance or charge is exempt or zero-rated. Used for the French e-invoicing reform (FR-FE EXT-FR-FE-187/189). Maps to UBL AllowanceCharge/TaxCategory/TaxExemptionReason and CII SpecifiedTradeAllowanceCharge/CategoryTradeTax/ExemptionReason
    string taxExemptionReason?;
    # An array of taxes, duties and fees for this invoice line. At this moment, multiple Tax items is allowed only for IN (India) and US (USA) taxes. All other countries can only have a single Tax item in this array
    Tax[] taxesDutiesFees?;
    # The reason code for the allowance or charge
    string reasonCode?;
    # The base amount for the allowance or charge, excluding tax
    decimal baseAmountExcludingTax?;
    # The amount for the allowance or charge, including tax
    decimal amountIncludingTax?;
};

# The C5 email cancellation request object
public type C5EmailCancellationRequest record {
    # The identifier
    string identifier;
    # The scheme
    "SG:UEN" scheme;
    # The superscheme
    "iso6523-actorid-upis" superscheme;
};

# A document attachment to the invoice
public type Attachment record {
    # The name of the file attachment
    string filename?;
    # DEPRECATED. Whether or not this document is a visual representation of the invoice data. Note that using value 'true' is discouraged, since the invoice data itself is leading, not the image, and including an image may lead to confusion. Peppol no longer allows including primary images
    boolean primaryImage = false;
    # The base64 encoded version of the document attachment
    @constraint:String {minLength: 5}
    string document;
    # A description for the file attachment
    @constraint:String {maxLength: 1024}
    string description?;
    # An id for the file attachment
    @constraint:String {maxLength: 64}
    string documentId?;
    # The document attachment mime type
    "text/csv"|"application/pdf"|"image/png"|"image/jpeg"|"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"|"application/vnd.oasis.opendocument.spreadsheet" mimeType;
};

public type Tax record {
    # An ISO 3166-1 alpha-2 country code
    Country country;
    # The amount of tax. Mandatory if taxSystem == 'tax_line_amounts'. However, it is best to use taxSystem tax_line_percentages and provide only the percentage, not the actual amount. The amount is then provided at the invoice level, in the taxSubtotals element
    decimal amount?;
    # The percentage Tax. This should be a valid Tax percentage in the country at the time of the issueDate of this invoice. Mandatory if taxSystem == 'tax_line_percentages'
    decimal percentage?;
    # When specifying a tax country other than that of the sender or the receiver, this flag must be set. This is to prevent accidental errors
    boolean acknowledgeThirdCountryTax = false;
    # The allowed values depend on the country of the tax:
    # ++++
    # <ul>    <li>        AE:        <ul>            <li>standard (5%)</li>            <li>standard_additional(5%)</li>            <li>reverse_charge (0%)</li>            <li>zero_rated (0%)</li>            <li>exempt (0%)</li>            <li>export (0%)</li>            <li>outside_scope (0%)</li>        </ul>    </li>    <li>        AU:        <ul>            <li>standard (10%, 5.5%)</li>            <li>zero_rated (0%)</li>            <li>exempt (0%)</li>            <li>export (0%)</li>            <li>outside_scope (0%)</li>        </ul>    </li>    <li>        EU:        <ul>            <li>standard (percentages country dependent)</li>            <li>zero_rated (0%)</li>            <li>reverse_charge (0%)</li>            <li>intra_community (0%)</li>            <li>exempt (0%)</li>            <li>export (0%)</li>            <li>outside_scope (0%)</li>        </ul>    </li>    <li>        EU/IT:        <ul>            <li>standard</li>            <li>zero_rated (0%)</li>            <li>reverse_charge (0%)</li>            <li>intra_community (0%)</li>            <li>exempt (0%)</li>            <li>export (0%)</li>            <li>outside_scope (0%)</li>            <li>bollo_virtuale (only at the invoice level and with mandatory amount: €2.00)</li>        </ul>    </li>    <li>        IN:        <ul>            <li>igst (28%, 18%, 12%, 5%, 3%, 0.25%)</li>            <li>sgst (14%, 9%, 6%, 2.5%, 1.5%)</li>            <li>cgst (14%, 9%, 6%, 2.5%, 1.5%)</li>            <li>cess (any percentage)</li>            <li>state_cess (any percentage)</li>            <li>reverse_charge (0%)</li>            <li>exempt (0%)</li>            <li>export (0%)</li>            <li>outside_scope (0%)</li>            <li>zero_rated (0%)</li>        </ul>    </li>    <li>        JP:        <ul>            <li>standard (10%, 8%)</li>            <li>exempt (0%)</li>            <li>export (0%)</li>            <li>outside_scope (0%)</li>        </ul>    </li>    <li>        MX:        <ul>            <li>standard (16%)</li>            <li>exempt (0%)</li>            <li>export (0%)</li>            <li>outside_scope (0%)</li>            <li>ieps</li>            <li>wht</li>        </ul>    </li>    <li>        MY:        <ul>            <li>sales (5%, 10%) ⮕ LHDNM '01', Peppol 'T'            <li>sales_zero (0%) ⮕ LHDNM '01', Peppol 'E'            <li>sales_exempt (5%, 10%) ⮕ LHDNM 'E', Peppol 'E'            <li>service (6%, 8%) ⮕ LHDNM '02', Peppol 'T'            <li>service_zero (0%) ⮕ LHDNM '02', Peppol 'E'            <li>service_exempt (6%, 8%) ⮕ LHDNM 'E', Peppol 'E'            <li>tourism (any amount) ⮕ LHDNM '03', Peppol 'T'            <li>high_value_goods (any percentage) ⮕ LHDNM '04', Peppol 'T'            <li>low_value_goods (10%) ⮕ LHDNM '05', Peppol 'T'            <li>zero_rated (0%) ⮕ LHDNM '06', Peppol 'E'            <li>exempt (0%) ⮕ LHDNM 'E', Peppol 'E'            <li>export (0%) ⮕ LHDNM 'E', Peppol 'E'            <li>outside_scope (0%) ⮕ LHDNM '06', Peppol 'O'        </ul>    </li>    <li>        NZ:        <ul>            <li>standard (15%)</li>            <li>zero_rated (0%)</li>            <li>exempt (0%)</li>            <li>export (0%)</li>            <li>outside_scope (0%)</li>        </ul>    </li>    <li>        SG:        <table>            <tr>                <th>category</th>                <th>percentage</th>                <th>sales invoice</th>                <th>purchase invoice</th>            </tr>            <tr>                <td>standard</td>                <td>9%</td>                <td>SR</td>                <td>TX</td>            </tr>            <tr>                <td>outside_scope</td>                <td>0%</td>                <td>OS</td>                <td>OP</td>            </tr>            <tr>                <td>zero_rated</td>                <td>0%</td>                <td>ZR</td>                <td>ZP</td>            </tr>            <tr>                <td>not_registered</td>                <td>0%</td>                <td>NG</td>                <td>NR</td>            </tr>            <tr>                <td>deemed_supply</td>                <td>9%</td>                <td>DS</td>                <td></td>            </tr>            <tr>                <td>srca_c</td>                <td>9%</td>                <td>SRCA-C</td>                <td>TXCA</td>            </tr>            <tr>                <td>srovr_rs</td>                <td>9%</td>                <td>SROVR-RS</td>                <td></td>            </tr>            <tr>                <td>srovr_lvg</td>                <td>9%</td>                <td>SROVR-LVG</td>                <td></td>            </tr>            <tr>                <td>srlvg</td>                <td>9%</td>                <td>SRLVG</td>                <td></td>            </tr>            <tr>                <td>srca_s</td>                <td>0%</td>                <td>SRCA-S</td>                <td></td>            </tr>            <tr>                <td>regulation33_exempt</td>                <td>0%</td>                <td>ES33</td>                <td>EP</td>            </tr>            <tr>                <td>nonregulation33_exempt</td>                <td>0%</td>                <td>ESN33</td>                <td>EP</td>            </tr>            <tr>                <td>export</td>                <td>0%</td>                <td>ZR</td>                <td></td>            </tr>            <tr>                <td>not_applicable</td>                <td>0%</td>                <td>NA</td>                <td>TXNA</td>            </tr>            <tr>                <td>standard_ca (experimental)</td>                <td>9%</td>                <td></td>                <td>TXCA</td>            </tr>            <tr>                <td>standard_na (experimental)</td>                <td>9%</td>                <td></td>                <td>TXNA</td>            </tr>            <tr>                <td>standard_re (experimental)</td>                <td>9%</td>                <td></td>                <td>TX-RE</td>            </tr>            <tr>                <td>standard_n33 (experimental)</td>                <td>9%</td>                <td></td>                <td>TX-N33</td>            </tr>            <tr>                <td>standard_33 (experimental)</td>                <td>9%</td>                <td></td>                <td>TX-ESS</td>            </tr>            <tr>                <td>import_service (experimental)</td>                <td>9%</td>                <td></td>                <td>TXRC-TS</td>            </tr>            <tr>                <td>import_33_service (experimental)</td>                <td>9%</td>                <td></td>                <td>TXRC-ESS</td>            </tr>            <tr>                <td>import_n33_service (experimental)</td>                <td>9%</td>                <td></td>                <td>TXRC-N33</td>            </tr>            <tr>                <td>import_reverse_charge_service (experimental)</td>                <td>9%</td>                <td></td>                <td>TXRC-RE</td>            </tr>            <tr>                <td>import_goods (experimental)</td>                <td>9%</td>                <td></td>                <td>IM</td>            </tr>            <tr>                <td>import_33_goods (experimental)</td>                <td>9%</td>                <td></td>                <td>IM-ESS</td>            </tr>            <tr>                <td>import_n33_goods (experimental)</td>                <td>9%</td>                <td></td>                <td>IM-N33</td>            </tr>            <tr>                <td>import_reverse_charge_goods (experimental)</td>                <td>9%</td>                <td></td>                <td>IM-RE</td>            </tr>            <tr>                <td>import_mes (experimental)</td>                <td>9%</td>                <td></td>                <td>ME</td>            </tr>            <tr>                <td>import_gst_ds (experimental)</td>                <td>9%</td>                <td></td>                <td>IGDS</td>            </tr>            <tr>                <td>blocked (experimental)</td>                <td>9%</td>                <td></td>                <td>BL</td>            </tr>            <tr>                <td>exempt_purchase (experimental)</td>                <td>0%</td>                <td></td>                <td>EP</td>            </tr>        </table>        <p>When a received invoice is reported to IRAS with documentType invoice_report, each sales GST category of the received invoice is replaced by the code in the purchase invoice column; purchase categories already on the received invoice are kept. Categories without a purchase invoice code (deemed_supply, srovr_rs, srovr_lvg, srlvg, srca_s, export) cannot be reported this way: the request is rejected with a 422 and the invoice must be reported as a self-billing invoice (selfBillingMode true) with the purchase categories instead.</p>    </li>    <li>        US:        <ul>            <li>standard (any percentage)</li>            <li>exempt (0%)</li>            <li>export (0%)</li>            <li>outside_scope (0%)</li>        </ul>    </li></ul>
    # ++++
    "standard"|"zero_rated"|"reverse_charge"|"intra_community"|"exempt"|"export"|"outside_scope"|"regulation33_exempt"|"nonregulation33_exempt"|"deemed_supply"|"srca_s"|"srca_c"|"not_registered"|"igst"|"cgst"|"sgst"|"cess"|"state_cess"|"srovr"|"srovr_rs"|"srovr_lvg"|"srlvg"|"bollo_virtuale"|"exempt_it_n1"|"sales"|"service"|"tourism"|"high_value_goods"|"low_value_goods"|"sales_zero"|"service_zero"|"not_applicable"|"sales_exempt"|"service_exempt"|"standard_ca"|"standard_na"|"standard_re"|"standard_n33"|"standard_33"|"import_service"|"import_33_service"|"import_n33_service"|"import_reverse_charge_service"|"import_goods"|"import_33_goods"|"import_n33_goods"|"import_reverse_charge_goods"|"import_mes"|"import_gst_ds"|"blocked"|"exempt_purchase"|"standard_additional"|"ieps"|"wht" category?;
    # The type of tax. This field is only used for receiving. For sending, the type is automatically determined from the country code and should not be supplied
    "VAT"|"GST" 'type?;
};

# Represents the Queries record for the operation: getPurchaseInvoicePackaged
public type GetPurchaseInvoicePackagedQueries record {
    # DEPRECATED. The PaymentMeans version. The default (and deprecated) version 1.0 will give BankPaymentMean, DirectDebitPaymentMean, CardPaymentMean, NppPaymentMean, SeBankGiroPaymentMean, SePlusGiroPaymentMean, SgCardPaymentMean, SgGiroPaymentMean, SgPaynowPaymentMean.
    # 
    # Version 2.0 deprecates BankPaymentMean (now CreditTransferPaymentMean), CardPaymentMean (now CreditCardPaymentMean), NppPaymentMean (now AunzNppPayidPaymentMean), SeBankGiroPaymentMean (now SeBankgiroPaymentMean  -- note the lower 'g' in 'bankgiro'). It also adds OnlinePaymentServicePaymentMean, StandingAgreementPaymentMean, AunzNppPaytoPaymentMean, AunzBpayPaymentMean, AunzPostbillpayPaymentMean, AunzUriPaymentMean
    string pmv = "1.0";
    # The JSON content version date. The default is '1970-01-01' meaning you get all deprecated elements since nothing was deprecated before that ;). If you do not want deprecated elements, use a later date. Do not use a dynamic date, because that means when we deprecate elements they will disappear from our responses. Only used for 'json' packaging, not for 'original'
    @constraint:String {pattern: re `^d{4}-d{2}-d{2}$`}
    string version = "1970-01-01";
};

# The customer receiving the document
public type AccountingCustomerParty record {
    # A list of legal and tax identifiers for this customer
    PublicIdentifier[] publicIdentifiers?;
    # A party that can receive or send invoices
    Party party;
};

# The party to whom the invoice will be paid. Use this only if necessary, for instance in case of factoring (payment is to the factoring company), bankruptcy (payment is to the bankruptcy estate) or in other special cases
public type PayeeParty record {
    # A list of legal and tax identifiers for this party
    PublicIdentifier[] publicIdentifiers?;
    # A party that can receive or send invoices
    Party party;
};

# An agent acting on behalf of the buyer. Used in the French e-invoicing reform (FR-FE EXT-FR-FE-BG-01). Maps to UBL AccountingCustomerParty/Party/AgentParty and CII BuyerAgentTradeParty
public type BuyerAgentParty record {
    # A list of legal and tax identifiers for this party
    PublicIdentifier[] publicIdentifiers?;
    # A party that can receive or send invoices
    Party party;
};

public type CorpPassCreate record {
    # The name of the person who is going to perform the CorpPass process. Mandatory for flow_type="corppass_flow_email" and for redirect KYC on Dex
    @jsondata:Name {value: "signer_name"}
    string signerName?;
    # The URL the CorpPass system will redirect to in case of successful identity verfication. Mandatory for flow_type="corppass_flow_redirect"
    @jsondata:Name {value: "client_redirect_success_url"}
    string clientRedirectSuccessUrl?;
    # The CorpPass flow type. Note that using corppass_flow_pdf requires special setup of your account by Storecove
    @jsondata:Name {value: "flow_type"}
    "corppass_flow_redirect"|"corppass_flow_email"|"corppass_flow_pdf" flowType;
    # The Base64-encoded PDF document used for KYC. Mandatory for flow_type="corppass_flow_pdf"
    @jsondata:Name {value: "kyc_document"}
    string kycDocument?;
    # Whether or not to simulate CorpPass. Instead of redirecting to a CorpPass URL, you will receive a redirect to a Storecove URL which will show a page with two buttons: success and fail. This makes development without having test CorpPass credentials possible. Note this only works in sandbox, not in the production environment
    @jsondata:Name {value: "simulate_corppass"}
    boolean simulateCorppass = false;
    # The URL the CorpPass system will redirect to in case of a failure to perform identity verfication. Mandatory for flow_type="corppass_flow_redirect"
    @jsondata:Name {value: "client_redirect_fail_url"}
    string clientRedirectFailUrl?;
    # The email of the person who is going to perform the CorpPass process. Mandatory for flow_type="corppass_flow_email" and for redirect KYC on Dex
    @jsondata:Name {value: "signer_email"}
    string signerEmail?;
    # DEPRECATED. Whether or not to enable the CorpPass flow. Must be true if provided
    boolean enabled = true;
};

public type PurchaseInvoiceInvoiceLine record {
    # DEPRECATED - use tax. The VAT details for the invoice line
    VATDetails vat?;
    # The description for the invoice line
    string description?;
    PurchaseInvoiceTax tax?;
    PurchaseInvoiceInvoiceLineItem units?;
    PurchaseInvoiceAccountingDetails accounting?;
    # DEPRECATED - use allowance_charges
    @jsondata:Name {value: "allowance_charge"}
    decimal allowanceCharge?;
    # The end date of the period this invoice line relates to. Format "YYYY-MM-DD"
    @jsondata:Name {value: "period_end"}
    string periodEnd?;
    # The start date of the period this invoice line relates to. Format "YYYY-MM-DD"
    @jsondata:Name {value: "period_start"}
    string periodStart?;
    PurchaseInvoiceInvoiceLinePrice price?;
    # A short name for the invoice line
    string name?;
    # The amount excluding Tax. This is equal to quantity x price_amount + ∑ allowance_charges
    @jsondata:Name {value: "amount_excluding_tax"}
    decimal amountExcludingTax?;
    # Deprecated
    @jsondata:Name {value: "allowance_charges"}
    decimal[] allowanceCharges?;
    @jsondata:Name {value: "allowance_charge_array"}
    PurchaseInvoiceInvoiceLineAllowanceCharge[] allowanceChargeArray?;
    # DEPRECATED - use amount_excluding_tax. The amount excluding VAT
    @jsondata:Name {value: "amount_excluding_vat"}
    decimal amountExcludingVat?;
};

public type PaymentTaxSubtotal record {
    # Optional. The amount still to be paid for this VAT rate, VAT included, reported as remaining to pay (RAP)
    decimal remainingAmountIncludingVat?;
    # The VAT percentage the amount was received for. Must be one of the VAT percentages of the referenced invoice, which is checked when the stored payload of that invoice is still available
    decimal percentage;
    # The ISO 4217 currency code
    CurrencyCode currency?;
    # The amount actually received for this VAT rate, VAT included. Negative for a refund
    decimal amountIncludingVat;
};

public type LegalEntityUpdate record {
    # The zipcode
    @constraint:String {maxLength: 32, minLength: 2}
    string zip?;
    # The id of the tenant, to be used in case of multi-tenant solutions. This property will included in webhook events
    @jsondata:Name {value: "tenant_id"}
    string tenantId?;
    # An ISO 3166-1 alpha-2 country code
    Country country?;
    # Whether or not this LegalEntity can act as a receiver of documents. If not, no identifiers will be provioned on any exchange network
    @jsondata:Name {value: "acts_as_receiver"}
    boolean actsAsReceiver = true;
    # The city
    @constraint:String {maxLength: 64, minLength: 2}
    string city?;
    # Whether or not this LegalEntity is tax registered. This influences the validation of the data presented when sending documents
    @jsondata:Name {value: "tax_registered"}
    boolean taxRegistered = true;
    # The classification code for this LegalEntity. For Malaysia, this is the MSIC code. It is mandatory for MY legal entities
    @jsondata:Name {value: "classification_code"}
    string classificationCode?;
    # County, if applicable
    @constraint:String {maxLength: 64}
    string county?;
    # The name of the authority that issued the legal registration identifier. Used for UAE PINT-AE BTAE-11. See <<country_ae>>
    @jsondata:Name {value: "registration_authority_name"}
    string registrationAuthorityName?;
    ReaRegistration rea?;
    # DEPRECATED. Use the <<_openapi_receiveddocuments_resource>> endpoint. The email address of the Smart Inbox for this LegalEntity
    @jsondata:Name {value: "smart_inbox"}
    string smartInbox?;
    # A list of document groups to advertise.
    # ++++
    # <ul>    <li>        <strong>invoice</strong><br/>        Gives Invoice and where applicable CreditNote under the Billing process.<br/>    </li>    <li>        <strong>invoice_response</strong><br/>        Gives InvoiceResponse under the Invoice Response process.<br/>    </li>    <li>        <strong>selfbilling</strong><br/>        Gives Invoice and where applicable CreditNote under the Selfbilling process.<br/>    </li>    <li>        <strong>order</strong><br/>        Gives Order under the Order Only process.<br/>    </li>    <li>        <strong>ordering</strong><br/>        Gives Order and OrderResponse under the Ordering process.<br/>    </li>    <li>        <strong>advanced_ordering</strong><br/>        Gives Order, AdvancedOrderResponse, OrderChange and OrderCancellation under the Advanced Ordering process.<br/>    </li>    <li>        <strong>despatch_advice</strong><br/>        Gives DespatchAdvice under the Despatch Advice process.<br/>    </li>    <li>        <strong>advanced_ordering_sg_order_balance</strong><br/>        Gives OrderBalance under the Advanced Ordering SG Order Balance process.<br/>    </li>    <li>        <strong>remittance_advice</strong><br/>        Gives RemittanceAdvice (DBNAlliance only).<br/>    </li>    <li>        <strong>pidx_invoicing_ordering</strong><br/>        Gives PIDX Invoice, InvoiceResponse, OrderChange, OrderCreate and OrderResponse (DBNAlliance only).<br/>    </li></ul>
    # ++++
    ("invoice"|"invoice_response"|"selfbilling"|"order"|"ordering"|"advanced_ordering"|"advanced_ordering_sg_order_balance"|"remittance_advice"|"despatch_advice"|"pidx_invoicing_ordering")[] advertisements?;
    # The password to use to authenticate to a system through which to send the document, or to obtain tax authority approval to send it. This field is currently relevant only for India and mandatory when creating an IN LegalEntity
    @jsondata:Name {value: "third_party_password"}
    string thirdPartyPassword?;
    # Whether or not this LegalEntity can act as a sender of documents
    @jsondata:Name {value: "acts_as_sender"}
    boolean actsAsSender = true;
    # The name of the company
    @jsondata:Name {value: "party_name"}
    string partyName?;
    # Whether or not this LegalEntity is public. Public means it will be listed in the PEPPOL directory at https://directory.peppol.eu/ which is normally what you want. If you have a good reason to not want the LegalEntity listed, provide false. This property is ignored when for country SG, where it is always true
    boolean 'public = true;
    # The ISO 3166-1 alpha-2 country code, or Peppol extension 1A, for the authority that issued the passport. Used for UAE PINT-AE BTAE-19. See <<country_ae>>
    @jsondata:Name {value: "passport_issuing_country"}
    string passportIssuingCountry?;
    # The username to use to authenticate to a system through which to send the document, or to obtain tax authority approval to send it. This field is currently relevant only for India and mandatory when creating an IN LegalEntity
    @jsondata:Name {value: "third_party_username"}
    string thirdPartyUsername?;
    # The Storecove assigned id for the LegalEntity
    int id?;
    # The second address line, if applicable
    @constraint:String {maxLength: 192}
    string line2?;
    # If true, Storecove will use default credentials/signing artifacts even if specific ones are configured for this LegalEntity. Defaults to false
    @jsondata:Name {value: "override_own_credentials"}
    boolean overrideOwnCredentials = false;
    # The first address line
    @constraint:String {maxLength: 192, minLength: 2}
    string line1?;
};

# Represents the Queries record for the operation: getPurchaseInvoice
public type GetPurchaseInvoiceQueries record {
    # DEPRECATED. The PaymentMeans version. The default (and deprecated) version 1.0 will give BankPaymentMean, DirectDebitPaymentMean, CardPaymentMean, NppPaymentMean, SeBankGiroPaymentMean, SePlusGiroPaymentMean, SgCardPaymentMean, SgGiroPaymentMean, SgPaynowPaymentMean.
    # 
    # Version 2.0 deprecates BankPaymentMean (now CreditTransferPaymentMean), CardPaymentMean (now CreditCardPaymentMean), NppPaymentMean (now AunzNppPayidPaymentMean), SeBankGiroPaymentMean (now SeBankgiroPaymentMean  -- note the lower 'g' in 'bankgiro'). It also adds OnlinePaymentServicePaymentMean, StandingAgreementPaymentMean, AunzNppPaytoPaymentMean, AunzBpayPaymentMean, AunzPostbillpayPaymentMean, AunzUriPaymentMean
    string pmv = "1.0";
    # The JSON content version date. The default is '1970-01-01' meaning you get all deprecated elements since nothing was deprecated before that ;). If you do not want deprecated elements, use a later date. Do not use a dynamic date, because that means when we deprecate elements they will disappear from our responses
    @constraint:String {pattern: re `^d{4}-d{2}-d{2}$`}
    string version = "1970-01-01";
};

# An additional property for the item. Two valid forms: (a) textual — both `name` and `value` must be present; (b) coded measurement (FR-FE EXT-FR-FE-159/160/161) — all of `nameCode`, `valueQuantity` and `valueQuantityUnitCode` must be present. Cross-form validation is enforced by InvoiceSubmissionValidationService because our JSON Schema dialect does not support anyOf/allOf
public type AdditionalItemProperty record {
    # Coded identifier for the property (FR-FE EXT-FR-FE-159). Must be a UN/EDIFACT 6313 code (https://service.unece.org/trade/untdid/d00a/tred/tred6313.htm). Maps to UBL AdditionalItemProperty/NameCode and CII ApplicableProductCharacteristic/TypeCode
    string nameCode?;
    # The free-text name of the property. Maps to UBL AdditionalItemProperty/Name and CII ApplicableProductCharacteristic/Description
    @constraint:String {minLength: 1}
    string name?;
    # Unit of measure for `valueQuantity` (FR-FE EXT-FR-FE-161). Maps to UBL AdditionalItemProperty/ValueQuantity@unitCode and CII ApplicableProductCharacteristic/ValueMeasure@unitCode
    string valueQuantityUnitCode?;
    # The free-text value of the property. Maps to UBL AdditionalItemProperty/Value and CII ApplicableProductCharacteristic/Value
    string value?;
    # Numeric value of the measured property (FR-FE EXT-FR-FE-160). Maps to UBL AdditionalItemProperty/ValueQuantity and CII ApplicableProductCharacteristic/ValueMeasure
    string valueQuantity?;
};

public type PurchaseInvoice record {
    # The id of the LegalEntity the invoice was received for
    @jsondata:Name {value: "legal_entity_id"}
    int legalEntityId?;
    # The invoice level note
    string note?;
    # Deprecated. Used for accountants. The id you specified for the organization
    @jsondata:Name {value: "external_key"}
    string externalKey?;
    PurchaseInvoiceAttachment[] attachments?;
    # DEPRECATED - This is now part of each invoice line
    @jsondata:Name {value: "vat_reverse_charge"}
    boolean vatReverseCharge?;
    # Reference to the order. Used for matching the invoice to an order
    @jsondata:Name {value: "order_reference"}
    string orderReference?;
    # Reference to the project
    @jsondata:Name {value: "project_reference"}
    string projectReference?;
    # DEPRECATED. Use the new atatchments array
    string document?;
    # DEPRECATED - Use amount_including_tax
    @jsondata:Name {value: "amount_including_vat"}
    decimal amountIncludingVat?;
    @jsondata:Name {value: "payment_means"}
    PaymentMeansDEPRECATED paymentMeans?;
    PurchaseInvoiceAccountingDetails accounting?;
    # The source the invoice was received from
    "peppol"|"script"|"supplier"|"email" 'source?;
    # DEPRECATED - use the payment_id property in the payment_means_array
    @jsondata:Name {value: "payment_means_payment_id"}
    string paymentMeansPaymentId?;
    # The tax system of the invoice. Either tax_line_percentages or tax_line_amounts. The first tax system means the invoice lines contain only the tax percentages and the tax amounts are included only in the tax subtotals at the invoice level and so are only calculated at the invoice level. The tax system tax_line_amounts means that in addition to the percentage, each invoice line also contains the tax amount. The tax subtotals at the invoice level are calculated as the sum of the tax of the invoice lines. The distinction between the two tax systems has has implications for rounding
    @jsondata:Name {value: "tax_system"}
    string taxSystem?;
    # The accounting cost code
    @jsondata:Name {value: "accounting_cost"}
    string accountingCost?;
    # The different payment means that can be used to pay the invoice
    @jsondata:Name {value: "payment_means_array"}
    PurchaseInvoicePaymentMeans[] paymentMeansArray?;
    # The date the invoice was issued. Format "YYYY-MM-DD"
    @jsondata:Name {value: "issue_date"}
    string issueDate?;
    # The subtype of document
    @jsondata:Name {value: "sub_type"}
    "invoice"|"creditnote"|"correctioninvoice" subType?;
    # The ISO 4217 currency for the invoice
    @jsondata:Name {value: "document_currency_code"}
    string documentCurrencyCode?;
    # The start date of the period this invoice relates to. Format "YYYY-MM-DD"
    @jsondata:Name {value: "period_start"}
    string periodStart?;
    # The type of invoice
    @jsondata:Name {value: "invoice_type"}
    "invoice"|"creditnote"|"correctioninvoice" invoiceType?;
    # The invoicenumber
    @jsondata:Name {value: "invoice_number"}
    string invoiceNumber?;
    # The type of document. Only "invoice" for now
    @jsondata:Name {value: "document_type"}
    "invoice" documentType?;
    # The details of the delivery associated with this invoice
    PurchaseInvoiceDelivery delivery?;
    # The code describing which date is used as the tax point date. Supported values: 3 (invoice issue date), 35 (actual delivery date), 432 (paid to date)
    @jsondata:Name {value: "tax_point_date_code"}
    "3"|"35"|"432" taxPointDateCode?;
    # The date the invoice must be payed by. Format "YYYY-MM-DD"
    @jsondata:Name {value: "due_date"}
    string dueDate?;
    # Reference to the previous invoice this invoice relates to
    @jsondata:Name {value: "billing_reference"}
    string billingReference?;
    @jsondata:Name {value: "document_totals"}
    PurchaseInvoiceDocumentTotals documentTotals?;
    @jsondata:Name {value: "tax_subtotals"}
    PurchaseInvoiceTaxSubtotal[] taxSubtotals?;
    # The date the invoice was issued for tax purposes. In most countries MUST match the issue_date. Format "YYYY-MM-DD"
    @jsondata:Name {value: "tax_point_date"}
    string taxPointDate?;
    # Reference provided by the buyer. Used for routing
    @jsondata:Name {value: "buyer_reference"}
    string buyerReference?;
    # DEPRECATED - Use the allowance_charges array
    @jsondata:Name {value: "allowance_charge"}
    decimal allowanceCharge?;
    # Deprecated. Used for the embedded portal retrieval service. The external_user_id you provided when the ShopAccount was created
    @jsondata:Name {value: "external_user_id"}
    string externalUserId?;
    # The end date of the period this invoice relates to. Format "YYYY-MM-DD"
    @jsondata:Name {value: "period_end"}
    string periodEnd?;
    # Whether or not the document image (PDF) was generated by Storecove. If true, it means the invoice was received without any attachments and Storecove generated one for you. If false, the invoice will contain at least one attachment, which was received from the invoice sender
    @jsondata:Name {value: "system_generated_primary_image"}
    boolean systemGeneratedPrimaryImage?;
    PurchaseInvoiceSender sender?;
    # The GUID of the invoice
    string guid?;
    @jsondata:Name {value: "allowance_charges"}
    PurchaseInvoiceAllowanceCharge[] allowanceCharges?;
    # A textual description of the payment terms
    @jsondata:Name {value: "payment_terms_note"}
    string paymentTermsNote?;
    # Reference to the contract
    @jsondata:Name {value: "contract_document_reference"}
    string contractDocumentReference?;
    @jsondata:Name {value: "invoice_lines"}
    PurchaseInvoiceInvoiceLine[] invoiceLines?;
};

public type PurchaseInvoiceSender record {
    # The zip code
    string zip?;
    # The country
    string country?;
    # The city
    string city?;
    @jsondata:Name {value: "billing_contact"}
    PurchaseInvoiceSenderBillingContact billingContact?;
    # The array of identifiers for this sender
    PeppolIdentifier[] identifiers?;
    # The county
    string county?;
    # DEPRECATED - Use the identifiers array
    @jsondata:Name {value: "peppol_identifiers"}
    PeppolIdentifier[] peppolIdentifiers?;
    # The secondary number. Used in SA
    @jsondata:Name {value: "secondary_number"}
    string secondaryNumber?;
    # The party who sent the invoice
    @jsondata:Name {value: "party_name"}
    string partyName?;
    # The legal name of the party who sent the invoice
    @jsondata:Name {value: "legal_name"}
    string legalName?;
    # The neighborhood. Used in SA
    string neighborhood?;
    # The department who sent the invoice
    string department?;
    # The address, line 2
    string line2?;
    # The address
    string line1?;
    # The building number. Used in SA
    @jsondata:Name {value: "building_number"}
    string buildingNumber?;
};

public type FrEReportB2cTransaction record {
    # Format: yyyy-mm-dd.
    @constraint:String {pattern: re `^[0-9]{4}-[0-9]{2}-[0-9]{2}$`}
    string date;
    string currency?;
    string vatPaymentOption?;
    # Flux 10 CategoryCode (Annexe 7 G1.68). Required; omitting it or sending a blank/unknown value makes PPF reject the archive as IRR_SYNTAX.
    "TLB1"|"TPS1"|"TNT1"|"TMA1" category;
    decimal amountExcludingVat?;
    decimal amountIncludingVat?;
    @constraint:Int {minValue: 0}
    int transactionsCount?;
    record {}[] taxSubtotals?;
};

public type DocumentSubmissionEvidenceEvidence record {
    # The IP address of the sending SMTP server. Only used for network "email"
    @jsondata:Name {value: "remote_mta_ip"}
    string remoteMtaIp?;
    # The signature assiged by the tax authority or its authorized partner. Used for network india
    string signature?;
    # An identification of the OpenPeppol accesspoint that the invoice was sent to. Only used for exchange networks like peppol and dbnalliance
    @jsondata:Name {value: "receiving_accesspoint"}
    string receivingAccesspoint?;
    # The meaning of this field varies, depending on the network. For peppol and dbnaliance, this is the message id of the envelope. For sdi, this is the filename assigned to the document
    @jsondata:Name {value: "message_id"}
    string messageId?;
    # Only used for application sg-iras
    @jsondata:Name {value: "acknowledgement_id"}
    string acknowledgementId?;
    # The UUID in the generated XML document. Only used for application my-lhdnm and sg-iras
    @jsondata:Name {value: "document_id"}
    string documentId?;
    # The response of the receiving SMTP server. Only used for network "email"
    @jsondata:Name {value: "smtp_response"}
    string smtpResponse?;
    # The meaning of this field varies, depending on the network. For my-lhdnm, it is the UUID
    @jsondata:Name {value: "partner_key"}
    string partnerKey?;
    # The XML evidence for the transmission. This is the XML returned by the receiving accesspoint, either OpenPeppol or DBNAlliance
    string 'xml?;
    # Only used for application my-lhdnm
    @jsondata:Name {value: "long_id"}
    string longId?;
    # The sequence number of the signature assiged by the tax authority or its authorized partner. Used for network india
    @jsondata:Name {value: "signature_number"}
    string signatureNumber?;
    # Only used for application sg-iras
    @jsondata:Name {value: "correlation_id"}
    string correlationId?;
    # The QR Code assiged by the tax authority or its authorized partner. Used for networks india and pt-b2b
    @jsondata:Name {value: "qr_code"}
    string qrCode?;
    # An identification for the sending SMTP. Only used for network "email"
    @jsondata:Name {value: "reporting_mta"}
    string reportingMta?;
    # The unique id for this transmission. The meaning of this field varies, depending on the network
    @jsondata:Name {value: "transmission_id"}
    string transmissionId?;
    # The datetime of the signature assiged by the tax authority or its authorized partner. Used for network india
    @jsondata:Name {value: "signature_date_time"}
    string signatureDateTime?;
    # The timestamp of the delivery to the receiving SMTP server. Only used for network "email"
    string timestamp?;
};

# A transportable document. Currently only used for receiving
public type Transportable record {
    # The document as originally received. Process this as a blob. Only present if requested
    string original?;
    # The id of the LegalEntity this document should be sent on behalf of or was received for
    int legalEntityId?;
    # The received document
    ReceivableDocument document?;
    # The GUID of the document that was received
    string guid?;
    # The direction of the document
    "in"|"out" direction?;
};

# A document to send, in base64 encoded format
public type RawDocumentData record {
    # How to parse the document
    "ubl"|"cii"|"idoc"|"setu14" parseStrategy?;
    # The base64 encoded version of the document
    @constraint:String {minLength: 5}
    string document;
    # DEPRECATED. Will be ignored
    boolean parse = true;
};

# A public identifier for this customer
public type PublicIdentifier record {
    # The scheme of the identifier. See <<_receiver_identifiers_list>> for a list
    @constraint:String {minLength: 3}
    string scheme;
    # The actual identifier
    @constraint:String {minLength: 1}
    string id;
};

public type PurchaseInvoiceTaxSubtotal record {
    # DEPRECATED - Use tax
    PurchaseInvoiceVat vat?;
    # The amount excluding tax
    @jsondata:Name {value: "amount_excluding_tax"}
    decimal amountExcludingTax?;
    PurchaseInvoiceTax tax?;
    # DEPRECATED - use amount_excluding_tax
    @jsondata:Name {value: "amount_excluding_vat"}
    string amountExcludingVat?;
};

public type InvoiceLine record {
    # The type of goods or services subject to the reverse charge mechanism (BTAE-09). Only used when the sender country is AE (PINT-AE), where it is mandatory for lines with tax category 'reverse_charge'. Maps to UBL CommodityClassification/NatureCode. Values must be from the UAE GoodsType / RCM code list (DL8.48.8.2, DL8.48.8.1, DL8.48.3.1, DL8.48.3.2, DL8.48.3.3). See <<country_ae>>
    "DL8.48.8.2"|"DL8.48.8.1"|"DL8.48.3.1"|"DL8.48.3.2"|"DL8.48.3.3" natureCode?;
    # DEPRECATED. Use notes instead. A note to add to the document line
    string note?;
    # An array of additional item properties
    AdditionalItemProperty[] additionalItemProperties?;
    # Whether the invoiced item concerns goods (G), services (S) or both (B) (BTAE-13). Only used when the sender country is AE (PINT-AE). Maps to UBL CommodityClassification/CommodityCode. When G or B, an item classification code with documentIdListId 'HS' is required in the references array (documentType 'item_classification_code'). When S or B, a serviceAccountingCode is required. See <<country_ae>>
    "G"|"S"|"B" itemType?;
    # The buyer's accounting cost centre for this invoice line, expressed as text
    @constraint:String {minLength: 1}
    string accountingCost?;
    # An array of notes attached to this invoice line. Used for the French e-invoicing reform (FR-FE EXT-FR-FE-183) and equivalent constructs in other syntaxes
    string[] notes?;
    # An array of references to other documents or codes. Note that many syntaxes do not support multiple references of the same type in which case they will be concatenated with ','. Also, not all syntaxes support all documentTypes
    Reference[] references?;
    # The description for this invoice line
    @constraint:String {minLength: 1}
    string description?;
    # DEPRECATED. Use the references array with 'line_standard_item_identification' documentType. The scheme for the standardized ID for the item
    @constraint:String {minLength: 1}
    string standardItemIdentificationSchemeId = "GTIN";
    # An array of allowances and charges
    LineAllowanceCharge[] allowanceCharges?;
    # DEPRECATED. Use price.baseQuantity instead. The number of items (may be fractional) the price is for
    decimal baseQuantity?;
    # The period (or specific date) to which the invoice line applies. Format: yyyy-mm-dd - yyyy-mm-dd
    @constraint:String {pattern: re `^[0-9]{4}-[0-9]{2}-[0-9]{2} - [0-9]{4}-[0-9]{2}-[0-9]{2}$`}
    string invoicePeriod?;
    # The price details for the invoice line
    Price price?;
    # DEPRECATED. Use a reference with type 'line_purchase_order'. A reference to the LineID of the order. The order itself is specified as the orderReference at the invoice level. It is not possible to specify an orderReference at the invoice line level. An invoice MUST at this time be for a single order only
    @constraint:String {minLength: 1}
    string orderLineReferenceLineId?;
    # DEPRECATED. Use the references array with 'line_buyers_item_identification' documentType. The ID the buyer assigned to this item
    @constraint:String {minLength: 1}
    string buyersItemIdentification?;
    # DEPRECATED. Use allowanceCharges. The discount or surcharge on this item. Should be negative for discounts
    decimal allowanceCharge?;
    # The amount excluding tax. Should equal price.priceAmount x quantity / price.baseQuantity + line-level allowanceCharges. Price-level discounts are already included in priceAmount
    decimal amountExcludingVat?;
    # The number of items (may be fractional)
    decimal quantity?;
    # The amount excluding tax. EXPERIMENTAL for sending. Should equal price.priceAmount x quantity / price.baseQuantity + line-level allowanceCharges. Price-level discounts are already included in priceAmount
    decimal amountExcludingTax?;
    # The id for this invoice line
    @constraint:String {maxLength: 36, minLength: 1}
    string lineId?;
    Tax tax?;
    # The service accounting code (SAC) of the invoiced service (BTAE-17). Only used when the sender country is AE (PINT-AE), where it is mandatory when itemType is S or B. Maps to UBL AdditionalItemIdentification with schemeID 'SAC'. See <<country_ae>>
    @constraint:String {maxLength: 64, minLength: 1}
    string serviceAccountingCode?;
    # The unit of measure that applies to the invoiced quantity. Codes for unit of packaging from UNECE Recommendation No. 21 can be used in accordance with the descriptions in the "Intro" section of UN/ECE Recommendation 20, Revision 11 (2015): The 2 character alphanumeric code values in UNECE Recommendation 21 shall be used. To avoid duplication with existing code values in UNECE Recommendation No. 20, each code value from UNECE Recommendation 21 shall be prefixed with an “X”, resulting in a 3 alphanumeric code when used as a unit of measure. Note that the following additionally allowed codes are deprecated and will be converted to C62: 04, 05, 08, 16, 17, 18, 19, 26, 29, 30, 31, 32, 36, 43, 44, 45, 46, 47, 48, 53, 54, 62, 63, 64, 66, 69, 71, 72, 73, 76, 78, 84, 90, 92, 93, 94, 95, 96, 97, 98, 1A, 1B, 1C, 1D, 1E, 1F, 1G, 1H, 1J, 1K, 1L, 1M, 1X, 2V, 2W, 3E, 3G, 3H, 3I, 4A, 4B, 4E, 5C, 5F, 5G, 5H, 5I, 5K, 5P, 5Q, A1, A25, A50, A51, A52, A57, A58, A60, A61, A62, A63, A64, A65, A66, A67, A77, A78, A79, A80, A81, A82, A83, AJ, AM, AP, AR, ARE, ATT, AV, AW, B0, B2, B36, B37, B38, B39, B40, B5, B51, B6, B65, B9, BD, BE, BG, BH, BJ, BK, BL, BO, BR, BT, BW, BX, BZ, C1, C2, C4, C5, C6, C77, C98, CA, CH, CJ, CK, CL, CO, CQ, CR, CS, CT, CU, CV, CY, CZ, D14, D28, D35, D37, D38, D39, D40, D64, D66, D67, D7, D70, D71, D72, D75, D76, D79, D8, D9, D90, D92, D96, D97, D98, D99, DC, DE, DI, DQ, DR, DRM, DS, DU, DX, DY, E2, E3, E5, EC, EP, EV, F1, F9, FB, FD, FE, FG, FM, G7, GC, GD, GH, GK, GN, GRT, GT, GW, GY, GZ, H1, H2, HAR, HD, HE, HF, HI, HJ, HK, HL, HN, HO, HP, HS, HT, HY, IC, IF, II, IL, IM, IP, IT, JB, JG, JO, JR, K5, KD, KF, KG, KS, KTM, LC, LE, LI, LJ, LX, M0, MA, MF, MK, MQ, MT, MV, N2, NB, NBB, NC, ND, NE, NG, NH, NI, NJ, NN, NPL, NPR, NQ, NR, NRL, NTT, NV, NY, OP, OZ, P0, P3, P4, P6, P7, P8, P9, PA, PB, PE, PF, PG, PK, PL, PM, PN, PT, PU, PV, PW, PY, PZ, QD, QH, QK, QT, R4, RA, RD, RG, RK, RL, RN, RO, RS, RU, S5, S6, S7, S8, SA, SD, SE, SHT, SK, SL, SN, SO, SP, SS, SST, ST, SV, T1, T4, T5, T6, T7, T8, TA, TC, TD, TE, TF, TJ, TK, TL, TN, TQ, TR, TS, TSD, TSH, TT, TU, TV, TW, TY, UA, UD, UE, UF, UH, UM, VI, VQ, VS, W4, WH, WI, WR, WW, YL, YT, Z1, Z2, Z3, Z4, Z5, Z6, Z8. Also, LOT can only be used for SG-IRAS invoices

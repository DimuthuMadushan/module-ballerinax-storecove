"|"XWM"|"XWN"|"XWP"|"XWQ"|"XWR"|"XWS"|"XWT"|"XWU"|"XWV"|"XWW"|"XWX"|"XWY"|"XWZ"|"XXA"|"XXB"|"XXC"|"XXD"|"XXF"|"XXG"|"XXH"|"XXJ"|"XXK"|"XYA"|"XYB"|"XYC"|"XYD"|"XYF"|"XYG"|"XYH"|"XYJ"|"XYK"|"XYL"|"XYM"|"XYN"|"XYP"|"XYQ"|"XYR"|"XYS"|"XYT"|"XYV"|"XYW"|"XYX"|"XYY"|"XYZ"|"XZA"|"XZB"|"XZC"|"XZD"|"XZF"|"XZG"|"XZH"|"XZJ"|"XZK"|"XZL"|"XZM"|"XZN"|"XZP"|"XZQ"|"XZR"|"XZS"|"XZT"|"XZU"|"XZV"|"XZW"|"XZX"|"XZY"|"XZZ"|"04"|"05"|"08"|"16"|"17"|"18"|"19"|"26"|"29"|"30"|"31"|"32"|"36"|"43"|"44"|"45"|"46"|"47"|"48"|"53"|"54"|"62"|"63"|"64"|"66"|"69"|"71"|"72"|"73"|"76"|"78"|"84"|"90"|"92"|"93"|"94"|"95"|"96"|"97"|"98"|"1A"|"1B"|"1C"|"1D"|"1E"|"1F"|"1G"|"1H"|"1J"|"1K"|"1L"|"1M"|"1X"|"2V"|"2W"|"3E"|"3G"|"3H"|"3I"|"4A"|"4B"|"4E"|"5C"|"5F"|"5G"|"5H"|"5I"|"5K"|"5P"|"5Q"|"A1"|"A25"|"A50"|"A51"|"A52"|"A57"|"A58"|"A60"|"A61"|"A62"|"A63"|"A64"|"A65"|"A66"|"A67"|"A77"|"A78"|"A79"|"A80"|"A81"|"A82"|"A83"|"AJ"|"AM"|"AP"|"AR"|"ARE"|"ATT"|"AV"|"AW"|"B0"|"B2"|"B36"|"B37"|"B38"|"B39"|"B40"|"B5"|"B51"|"B6"|"B65"|"B9"|"BD"|"BE"|"BG"|"BH"|"BJ"|"BK"|"BL"|"BO"|"BR"|"BT"|"BW"|"BX"|"BZ"|"C1"|"C2"|"C4"|"C5"|"C6"|"C77"|"C98"|"CA"|"CH"|"CJ"|"CK"|"CL"|"CO"|"CQ"|"CR"|"CS"|"CT"|"CU"|"CV"|"CY"|"CZ"|"D14"|"D28"|"D35"|"D37"|"D38"|"D39"|"D40"|"D64"|"D66"|"D67"|"D7"|"D70"|"D71"|"D72"|"D75"|"D76"|"D79"|"D8"|"D9"|"D90"|"D92"|"D96"|"D97"|"D98"|"D99"|"DC"|"DE"|"DI"|"DQ"|"DR"|"DRM"|"DS"|"DU"|"DX"|"DY"|"E2"|"E3"|"E5"|"EC"|"EP"|"EV"|"F1"|"F9"|"FB"|"FD"|"FE"|"FG"|"FM"|"G7"|"GC"|"GD"|"GH"|"GK"|"GN"|"GRT"|"GT"|"GW"|"GY"|"GZ"|"H1"|"H2"|"HAR"|"HD"|"HE"|"HF"|"HI"|"HJ"|"HK"|"HL"|"HN"|"HO"|"HP"|"HS"|"HT"|"HY"|"IC"|"IF"|"II"|"IL"|"IM"|"IP"|"IT"|"JB"|"JG"|"JO"|"JR"|"K5"|"KD"|"KF"|"KG"|"KS"|"KTM"|"LC"|"LE"|"LI"|"LJ"|"LX"|"M0"|"MA"|"MF"|"MK"|"MQ"|"MT"|"MV"|"N2"|"NB"|"NBB"|"NC"|"ND"|"NE"|"NG"|"NH"|"NI"|"NJ"|"NN"|"NPL"|"NPR"|"NQ"|"NR"|"NRL"|"NTT"|"NV"|"NY"|"OP"|"OZ"|"P0"|"P3"|"P4"|"P6"|"P7"|"P8"|"P9"|"PA"|"PB"|"PE"|"PF"|"PG"|"PK"|"PL"|"PM"|"PN"|"PT"|"PU"|"PV"|"PW"|"PY"|"PZ"|"QD"|"QH"|"QK"|"QT"|"R4"|"RA"|"RD"|"RG"|"RK"|"RL"|"RN"|"RO"|"RS"|"RU"|"S5"|"S6"|"S7"|"S8"|"SA"|"SD"|"SE"|"SHT"|"SK"|"SL"|"SN"|"SO"|"SP"|"SS"|"SST"|"ST"|"SV"|"T1"|"T4"|"T5"|"T6"|"T7"|"T8"|"TA"|"TC"|"TD"|"TE"|"TF"|"TJ"|"TK"|"TL"|"TN"|"TQ"|"TR"|"TS"|"TSD"|"TSH"|"TT"|"TU"|"TV"|"TW"|"TY"|"UA"|"UD"|"UE"|"UF"|"UH"|"UM"|"VI"|"VQ"|"VS"|"W4"|"WH"|"WI"|"WR"|"WW"|"YL"|"YT"|"Z1"|"Z2"|"Z3"|"Z4"|"Z5"|"Z6"|"Z8" quantityUnitCode = "C62";
    # DEPRECATED. Use 'line_standard_item_identification'. Standardized ID for the item
    @constraint:String {minLength: 1}
    string standardItemIdentification?;
    # DEPRECATED. Use the references array with 'line_standard_item_identification' documentType. The scheme agency for the standardized ID for the item
    @constraint:String {minLength: 1}
    string standardItemIdentificationSchemeAgencyId = "9";
    # A short name for this invoice line. If not provided, it will be taken from description and description will be set to an emtpy string
    @constraint:String {minLength: 1}
    string name?;
    # DEPRECATED. Use price.priceAmount instead. The net price per baseQuantity (may be fractional). This field remains available for compatibility with older connections
    decimal itemPrice?;
    # An array of taxes, duties and fees for this invoice line. Multiple taxesDutiesFees items is allowed only for IN (India) and US (USA) taxes. All other countries can only have a single Tax item in this array
    Tax[] taxesDutiesFees?;
    # The amount including tax. Can only be used for "priceMode": "price_mode_gross". Use either this property or amountExcludingTax (amountExcludingVat)
    decimal amountIncludingTax?;
    # DEPRECATED. Use the references array with 'line_sellers_item_identification' documentType. The ID the seller assigned to this item
    @constraint:String {minLength: 1}
    string sellersItemIdentification?;
};

public type FrEReportB2bPayment record {
    string invoiceNumber?;
    # Format: yyyy-mm-dd.
    @constraint:String {pattern: re `^[0-9]{4}-[0-9]{2}-[0-9]{2}$`}
    string issueDate?;
    # Format: yyyy-mm-dd.
    @constraint:String {pattern: re `^[0-9]{4}-[0-9]{2}-[0-9]{2}$`}
    string paymentDate?;
    decimal amount?;
    string currency?;
    string paymentMeansCode?;
    record {}[] taxSubtotals?;
};

# A participant to be discovered
public type DiscoverableParticipant record {
    # The actual identifier
    @constraint:String {minLength: 1}
    string identifier;
    # The scheme of the identifier. See <<_receiver_identifiers_list>> for a list
    @constraint:String {minLength: 3}
    string scheme;
    # The meta scheme of the identifier. For Peppol this is always 'iso6523-actorid-upis'
    @constraint:String {minLength: 3}
    string metaScheme = "iso6523-actorid-upis";
    # An array of document types to discover. The default is '["invoice", "creditnote"]'. This is ignored when only checking existence
    ("invoice"|"creditnote"|"invoice_response"|"order"|"ordering"|"order_response")[] documentTypes?;
    # A flag to filter for documents
    DiscoveryFlag flags?;
    # The network to check. Currently only 'peppol' is supported
    @constraint:String {minLength: 3}
    string network = "peppol";
};

# The receiver of the document
public type Receiver record {
    # The government receiver of the document
    GovernmentReceiver government?;
    # The business receiver of the document
    BusinessReceiver business?;
    # The consumer receiver of the document
    ConsumerReceiver consumer?;
};

public type Shipment record {
    # A list of charges
    AllowanceCharge[] allowanceCharges?;
    # A text that the buyer requests to be printed on the packing labels. Used only for DocumentOrder
    @constraint:String {maxLength: 128}
    string shippingMarks?;
    # The address
    Address originAddress?;
};

public type PurchaseInvoiceTax record {
    # The tax element
    PurchaseInvoiceTaxElement tax?;
};

public type FrEReportTransactionReport record {
    # The period the transaction report covers. Format: yyyy-mm-dd - yyyy-mm-dd.
    @constraint:String {pattern: re `^[0-9]{4}-[0-9]{2}-[0-9]{2} - [0-9]{4}-[0-9]{2}-[0-9]{2}$`}
    string period;
    # B2B cross-border invoices to report (sales and received cross-border lines as in the DGFiP test cases).
    FrEReportB2bCrossBorderInvoice[] b2biInvoices?;
    # Aggregated B2C transactions in France for the period.
    FrEReportB2cTransaction[] b2cTransactions?;
};

public type DgfipAnnuaireUpdate record {
    # Human-readable label for the routing code (annuaire central libelleCodeRoutage). Mandatory when the identifier carries a routing code
    @jsondata:Name {value: "routing_code_label"}
    string routingCodeLabel?;
    DgfipAnnuaireAddress address?;
};

# The C5 redirect cancellation request object
public type C5RedirectCancellationRequest record {
    # The identifier
    string identifier;
    # The scheme
    "SG:UEN" scheme;
    # The superscheme
    "iso6523-actorid-upis" superscheme;
};

# Identifies the invoice recipient to preflight
public type InvoiceRecipientPreflight record {
    # A list of public identifiers that uniquely identify this customer
    PublicIdentifiers publicIdentifiers?;
};

# The price details for the invoice line
public type Price record {
    # An array of signed item-price discounts that use the same baseQuantity scale. amountExcludingTax must not be positive: zero is a no-op discount, and a price-level charge is not allowed (PEPPOL-EN16931-R044). When baseAmountExcludingTax is provided, priceAmount must equal baseAmountExcludingTax + amountExcludingTax. Only a single item is currently supported, and reason fields are not allowed
    @constraint:Array {maxLength: 1}
    PriceAllowanceCharges[] allowanceCharges?;
    # The number of items (may be fractional) the priceAmount is for
    decimal baseQuantity?;
    # The net item price per baseQuantity (may be fractional). Supersedes the deprecated itemPrice property
    decimal priceAmount?;
};

public type LegalEntityApiKeys record {
    @jsondata:Name {value: "api_keys"}
    string[] apiKeys?;
};

# Represents the Queries record for the operation: getReceivedDocument
public type GetReceivedDocumentQueries record {
    # The JSON content version date. The default is '1970-01-01' meaning you get all deprecated elements since nothing was deprecated before that ;). If you do not want deprecated elements, use a later date. Do not use a dynamic date, because that means when we deprecate elements they will disappear from our responses. Only used for 'json' packaging, not for 'original'. Not currently used for invoices, only for orders
    @constraint:String {pattern: re `^d{4}-d{2}-d{2}$`}
    string version = "1970-01-01";
};

public type LegalEntityPeppolIdentifiers record {
    @jsondata:Name {value: "peppol_identifiers"}
    PeppolIdentifier[] peppolIdentifiers?;
};

# Legal name and address fields as used in e-reporting samples
public type FrEReportParty record {
    string companyName?;
};

# The result of preflighting an invoice recipient
public type PreflightInvoiceRecipientResult record {
    # The result code of the preflight request
    "ok"|"nok" code?;
};

# The response to a C5 deactivation request
public type C5DeactivationResponse record {
    # The URL to redirect to
    @jsondata:Name {value: "redirect_url"}
    string redirectUrl;
};

# A public identifier for this customer
public type DiscoveredParticipant record {
    # The response code
    "OK"|"NOK" code?;
    # DEPRECATED. Whether or not an 'OK' response means the document will be sent via Peppol, but delivered by email. This happens in the Belgian Hermes system where all identifiers have been registered, but if the receiver hasn't registered with a service provider, the Hermes system will send a PDF created from the electronic invoice and email that. The electronic document will itself not be emailed. Also see https://einvoice.belgium.be/en/article/send-structured-invoices-all-your-customers-hermes[Hermes^]
    boolean email?;
};

public type AdministrationUpdate record {
    # The id of the SenderEmailIdentity. If not provided, the Storecove default sender will be used
    @jsondata:Name {value: "sender_email_identity_id"}
    int senderEmailIdentityId?;
    # The version of the package
    @jsondata:Name {value: "package_version"}
    "peppol_bis_v3"|"aunz"|"sg" packageVersion?;
    # How to package the purchase invoice
    "ubl" packaging?;
    # The email address to send the received document to
    @constraint:String {maxLength: 128, minLength: 5}
    string email?;
};

# The payment terms of the document. Note that not all syntaxes support payment terms, so in some syntaxes they will converted into a payment terms note and it is even possible that they have to be omitted completely, for instance in many eReporting syntaxes (where they don't play a role anyway).
# ++++
# <br/>
# ++++
# Provide either the note or the terms, but not both
public type PaymentTerms record {
    # The note for the payment terms
    string note?;
    # The terms for the payment terms
    PaymentTerm[] terms?;
};

# A PrepaidPayment is a single prepaid payment. Each prepaid payment consists of at least the amount of the payment
public type PrepaidPayment record {
    # The date on which the payment was made
    string date?;
    # The reference of the payment
    @constraint:String {maxLength: 128, minLength: 1}
    string reference?;
    # The amount of the payment
    decimal amount;
    # The time zone at which the payment was made. Format: ±zzzz, where ±zzzz is the difference from UTC, e.g. +0100 or -0900 etc. Mandatory if time is provided
    @constraint:String {pattern: re `^[+-]\d{4}$`}
    string timeZone?;
    # The time at which the payment was made
    @constraint:String {pattern: re `^[0-9]{2}:[0-9]{2}:[0-9]{2}$`}
    string time?;
};

public type ReceivedDocument record {
    # The GUID of the received document
    string guid?;
};

# The document you want Storecove to send, with some meta-data
public type DocumentSubmission record {
    # The different ways to send the invoice to the recipient. The publicIdentifiers are used to send via the Peppol network, if the recipient is not registered on the Peppol network, the invoice will be sent to the email addresses in the emails property. This property is only mandatory when sending the invoice data using the <<_openapi_invoice>> property, not when sending using the <<_openapi_invoicedata>> property, in which case this information will be extracted from the <<_openapi_invoicedata>> object. If you do specify an <<_openapi_invoicerecipient>> object and an <<_openapi_invoicedata>> object, the data from the two will be merged
    Routing routing?;
    # DEPRECATED. Use the attachments array inside the 'document' property. An array of attachments. You may provide up to 10 attchments, but the total size must not exceed 100MB after Base64 encoding
    @constraint:Array {maxLength: 10}
    Attachment[] attachments?;
    # The id of the LegalEntity this document should be sent on behalf of. Either legalEntityId or forDocumentGuid is mandatory, unless the document type uses forDocumentSubmissionGuid instead
    int legalEntityId?;
    # DEPRECATED. The GUID that was in the received_document webhook. Use forDocumentGuid instead
    string receiveGuid?;
    # A guid that you generated for this DocumentSubmission to achieve idempotency. If you submit multiple documents with the same idempotencyGuid, only the first one will be processed and any subsequent ones will trigger an HTTP 422 Unprocessable Entity response
    @constraint:String {maxLength: 36, minLength: 36}
    string idempotencyGuid?;
    # The document to send
    SendableDocument document?;
    # The GUID that was in the received_document webhook. Use this field for document types that refer to a received document, such as InvoiceResponse and OrderResponse. Provide forDocumentGuid instead of legalEntityId for those flows
    string forDocumentGuid?;
    # The GUID of an earlier DocumentSubmission that this submission refers to. For documentType=payment_received_notification, this must be the GUID of the original French invoice DocumentSubmission the payment notification is for. For this document type, provide forDocumentSubmissionGuid instead of legalEntityId or forDocumentGuid
    string forDocumentSubmissionGuid?;
    # DEPRECATED. In the future we will no longer support creating PDF invoices. Whether or not to create a primary image (PDF) if one is not provided. For customers who started from April 1st 2023, the default is false. For customers who started before that, the default is true
    boolean createPrimaryImage?;
};

public type InvoiceSubmissionEvidence record {
    # The guid for the InvoiceSubmission
    string guid?;
    # An array of actions taken to deliver the document
    InvoiceSubmissionActionEvidence[] actions?;
    # The overall status for this InvoiceSubmission
    string status?;
};

# E-reporting payload for France (DGFiP). Send with document.documentType "fr_e_report". The platform submits the report (FFE1025A) in the fr-dgfip workflow. Both camelCase frEReport and snake fr_e_report keys are accepted in the request body; the public schema uses frEReport. G6.29: exactly one of transactionReport (TB-2) or paymentReport (TB-3) must be present — not both, not neither (enforced at submission time; not expressible in OpenAPI 2.0). See also the France appendix in the API documentation
public type FrEReport record {
    # e.g. IN (initial) or RE (rectificative).
    @constraint:String {minLength: 1}
    string typeCode;
    # Identifier for this report instance.
    @constraint:String {minLength: 1}
    string documentId;
    # Format: yyyy-mm-dd.
    @constraint:String {pattern: re `^[0-9]{4}-[0-9]{2}-[0-9]{2}$`}
    string issueDate;
    # Format: hh:mm:ss (24-hour).
    @constraint:String {pattern: re `^[0-9]{2}:[0-9]{2}:[0-9]{2}$`}
    string issueTime;
    # Format: ±zzzz, where ±zzzz is the difference from UTC, e.g. +0100 or -0900. Applies to the report issue time (and, where relevant, the issue date context for processing).
    @constraint:String {pattern: re `^[+-]\d{4}$`}
    string timeZone;
    FrEReportDeclarantParty declarantParty;
    FrEReportTransactionReport transactionReport?;
    FrEReportPaymentReport paymentReport?;
};

public type PriceAllowanceCharges LineAllowanceCharge;

public type DocumentSubmissionEvidence record {
    # The legal identifier of the receiver, or the tax identifier if there is no legal identifier
    string receiver?;
    DocumentSubmissionEvidenceEvidence evidence?;
    # The legal identifier of the sender, or the tax identifier if there is no legal identifier
    string sender?;
    # An array of documents that were sent. For OpenPeppol, this is always a single document (it may contain a PDF inside). For Email, the number of documents depends on the number of attachments, which in turn depends on the country of the receiver. For email, the raw email in RFC822 format is also included
    DocumentSubmissionEvidenceDocument[] documents?;
    # The guid for the InvoiceSubmission
    string guid?;
    # The network that was used to clear or send the document
    "storecove"|"as2"|"email"|"peppol"|"dbnalliance"|"sdi"|"in-irp"|"pt-b2b"|"ch-qrbill"|"finvoice"|"pl-ksef"|"spain-face"|"spain-faceb2b"|"my-lhdnm"|"ae-fta" network?;
};

public type DeliveryDeliveryLocation record {
    # The name of the delivery location. Only used for DocumentOrder
    @constraint:String {maxLength: 128}
    string locationName?;
    # The address
    Address address?;
    # DEPRECATED. The schemeAgencyId of the location identifier (e.g. 'ZZZ')
    string schemeAgencyId?;
    # The schemeId of the location identifier (e.g. 'EAN')
    string schemeId?;
    # The location identifier
    @constraint:String {minLength: 2}
    string id?;
};

# The business receiver of the document
public type BusinessReceiver record {
    CountrySpecificationIdentifier routing?;
    CountrySpecificationIdentifier legal?;
    CountrySpecificationIdentifier tax?;
};

public type PeppolIdentifierCreate record {
    # The identifier
    @constraint:String {maxLength: 64, minLength: 2}
    string identifier;
    # The scheme of the identifier. See <<_receiver_identifiers_list>> for a list
    @constraint:String {maxLength: 64, minLength: 2}
    string scheme;
    CorpPassCreate corppass?;
    # A specification of the networks to advertise the identifier on
    @jsondata:Name {value: "networks_specification"}
    NetworkSpecification[] networksSpecification?;
    # The superscheme of the identifier. Should always be "iso6523-actorid-upis"
    @constraint:String {maxLength: 64, minLength: 2}
    string superscheme;
    # DEPRECATED. Use the new "networks_specification" property. The networks to advertise the identifier on. Note that "dbnalliance" currently requires manual provisioning in the DBNAlliance SML, so you need to contact us before using this
    ("peppol"|"dbnalliance"|"dgfip")[] networks?;
};

# The invoice report to send. Reports a received invoice (forDocumentGuid) to the tax authority as a purchase, reusing the data of the received invoice.
# ++++
# <p>For SG (IRAS) the received invoice is reported on the payables profile, so every GST category on it is converted to its purchase invoice code (see the SG table in Tax). Received invoices can be reported with invoice_report when every GST category is either one of the sales categories standard (SR), outside_scope (OS), zero_rated (ZR), not_registered (NG), not_applicable (NA), srca_c (SRCA-C), regulation33_exempt (ES33) and nonregulation33_exempt (ESN33), which are converted, or already a purchase category (the purchase invoice column of the SG table, for example TXCA or EP on an invoice received via the API), which is kept as is. Received invoices that contain deemed_supply (DS), srlvg (SRLVG), srovr_rs (SROVR-RS), srovr_lvg (SROVR-LVG), srca_s (SRCA-S) or export are rejected with a 422 on forDocumentGuid; report those as a self-billing invoice (documentType invoice with selfBillingMode true) using the purchase GST categories.</p>
# ++++
public type DocumentInvoiceReport record {
    # The action to take
    @constraint:String {pattern: re `^send$`}
    string action;
};

public type PeppolIdentifier record {
    # The identifier
    @constraint:String {maxLength: 64, minLength: 2}
    string identifier?;
    # Read-only PPF idInstance for the directory line provisioned for this identifier. Omitted until the first successful sync. Present only for identifiers advertised on the "dgfip" network
    @jsondata:Name {value: "annuaire_line_id_instance"}
    string annuaireLineIdInstance?;
    # The scheme of the identifier. See <<_receiver_identifiers_list>> for a list
    @constraint:String {maxLength: 64, minLength: 2}
    string scheme?;
    CorpPass corppass?;
    # Read-only PPF idInstance for the routing code provisioned for this identifier. Omitted until the first successful sync, or when the identifier has no routing code. Present only for identifiers advertised on the "dgfip" network
    @jsondata:Name {value: "annuaire_routing_code_id_instance"}
    string annuaireRoutingCodeIdInstance?;
    # The superscheme of the identifier. Should always be "iso6523-actorid-upis"
    @constraint:String {maxLength: 64, minLength: 2}
    string superscheme?;
};

public type PurchaseInvoiceDocumentTotals record {
    # The total invoice amount, including tax. This is equal to the sum of the invoice_lines (amount_excluding_tax + tax.amount) and the allowances and charges
    decimal total?;
    # The total invoice amount payable including tax
    decimal payable?;
    # The difference between the payable amount and the total invoice amount including tax
    decimal rounding?;
    # The amount already paid
    decimal prepaid?;
};

# A PaymentTerm is a single term for the payment terms. Each term consists of the number of days within which the invoice must be settled and a discount percentage that applies if the invoice is settled within those days. If the amount to be calculated is based only on part of the amount due, the base amount for calculating the cash discount or late-payment interest must be specified as the baseAmount
public type PaymentTerm record {
    # The discount percentage that applies if the invoice is settled within the required number of days. Provide only one of discountPercentage or surchargePercentage
    decimal discountPercentage?;
    # The note for this payment term
    @constraint:String {maxLength: 1024}
    string note?;
    # The surcharge percentage that applies if the invoice is settled after the required number of days. Provide only one of discountPercentage or surchargePercentage
    decimal surchargePercentage?;
    # The number of days within which the invoice must be settled for the term to apply
    int settlementDays;
    # The base amount on which the discount percentage is applied
    decimal baseAmount?;
};

# The party that issues the invoice on behalf of the seller. Used in the French e-invoicing reform (FR-FE EXT-FR-FE-BG-05). Maps to UBL AccountingSupplierParty/Party/ServiceProviderParty/Party and CII InvoicerTradeParty
public type InvoicerParty record {
    # A list of legal and tax identifiers for this party
    PublicIdentifier[] publicIdentifiers?;
    # A party that can receive or send invoices
    Party party;
};

# The order to send
public type DocumentOrder record {
    # The type of this order
    "regular"|"consignment" orderType = "regular";
    # A note to add to the document
    @constraint:String {maxLength: 255}
    string note?;
    Delivery delivery?;
    DeliveryTerms deliveryTerms?;
    # The buyer's accounting cost centre for this document
    @constraint:String {minLength: 1}
    string accountingCost?;
    # An array of attachments. You may provide up to 10 attchments, but the total size must not exceed 100MB after Base64 encoding
    @constraint:Array {maxLength: 10}
    Attachment[] attachments?;
    # An array of references to other documents. Note that many syntaxes do not support multiple references of the same type in which case they will be concatenated with ','. Also, not all syntaxes and doucments support all documentTypes
    Reference[] references?;
    # Format: hh:mm:ss
    @constraint:String {pattern: re `^[0-9]{2}:[0-9]{2}:[0-9]{2}$`}
    string issueTime?;
    # The number you assigned to the document
    @constraint:String {minLength: 1}
    string documentNumber;
    # Format: ±zzzz, where ±zzzz is the difference from UTC, e.g. +0100 or -0900 etc. The timezone will also apply to the document issue date if this field is provided
    @constraint:String {pattern: re `^[+-]\d{4}$`}
    string timeZone?;
    # The buyer sending the order
    BuyerCustomerPartyOrder buyerCustomerParty?;
    # The period (or specific date) to which the invoice applies. Format: yyyy-mm-dd - yyyy-mm-dd
    @constraint:String {pattern: re `^[0-9]{4}-[0-9]{2}-[0-9]{2} - [0-9]{4}-[0-9]{2}-[0-9]{2}$`}
    string validityPeriod?;
    # The ISO 4217 currency code
    CurrencyCode documentCurrencyCode?;
    # The party sending the order
    SellerSupplierParty sellerSupplierParty;
    # An array of allowance charges
    AllowanceCharge[] allowanceCharges?;
    # An array of order lines
    @constraint:Array {minLength: 1}
    OrderLine[] orderLines;
    # The tax system used for the invoice. The system 'tax_line_percentages' is the only one currently supported
    "tax_line_percentages" taxSystem = "tax_line_percentages";
    # Format: yyyy-mm-dd
    @constraint:String {pattern: re `^[0-9]{4}-[0-9]{2}-[0-9]{2}$`}
    string issueDate;
    # Total amount including Tax
    decimal amountIncludingTax;
    # The payment terms of the document. Note that not all syntaxes support payment terms, so in some syntaxes they will converted into a payment terms note and it is even possible that they have to be omitted completely, for instance in many eReporting syntaxes (where they don't play a role anyway).
    # ++++
    # <br/>
    # ++++
    # Provide either the note or the terms, but not both
    PaymentTerms paymentTerms?;
};

# The party the goods/services were delivered to
public type PurchaseInvoiceParty record {
    # The name of the deliveyr party
    string name?;
};

public type CountrySpecifications record {
    CountrySpecification[] countries?;
};

# Contact details for the invoice
public type Contact record {
    string firstName?;
    string lastName?;
    @constraint:String {maxLength: 24}
    string phone?;
    # Only supported for AccountingCustomerParty
    @constraint:String {maxLength: 20}
    string id?;
    string email?;
};

public type PurchaseInvoiceAllowanceCharge record {
    # The reason for the allowance or charge
    string reason?;
    # DEPRECATED - Use tax
    PurchaseInvoiceVat vat?;
    # The amount excluding tax
    @jsondata:Name {value: "amount_excluding_tax"}
    decimal amountExcludingTax?;
    PurchaseInvoiceTax tax?;
    # DEPRECATED - use amount_excluding_tax
    @jsondata:Name {value: "amount_excluding_vat"}
    string amountExcludingVat?;
};

public type PurchaseInvoiceInvoiceLinePrice record {
    # The number of items the price is for. Can have up to digits
    @jsondata:Name {value: "base_quantity"}
    decimal baseQuantity?;
    # The price for one item, excluding VAT. Can have up to digits
    @jsondata:Name {value: "price_amount"}
    decimal priceAmount?;
};

# The party that pays the invoice when different from the buyer. Used in the French e-invoicing reform (FR-FE EXT-FR-FE-BG-02). Maps to UBL PaymentMeans/PaymentMandate/PayerParty and CII PayerTradeParty
public type PayerParty record {
    # A list of legal and tax identifiers for this party
    PublicIdentifier[] publicIdentifiers?;
    # A party that can receive or send invoices
    Party party;
};

public type LineDeliveryDeliveryLocation record {
    # The requested delivery period. If not present, will be taken from the document level. If that is not present, this field is mandatory
    @constraint:String {pattern: re `^[0-9]{4}-[0-9]{2}-[0-9]{2} - [0-9]{4}-[0-9]{2}-[0-9]{2}$`}
    string requestedDeliveryPeriod?;
    # The schemeId of the location identifier (e.g. '0088')
    string schemeId?;
    # The location identifier
    @constraint:String {minLength: 2}
    string id?;
};

public type FrEReportPaymentReport record {
    # The period the payment report covers. Format: yyyy-mm-dd - yyyy-mm-dd.
    @constraint:String {pattern: re `^[0-9]{4}-[0-9]{2}-[0-9]{2} - [0-9]{4}-[0-9]{2}-[0-9]{2}$`}
    string period;
    # Payments for B2B / cross-border invoices in scope.
    FrEReportB2bPayment[] b2biPayments?;
    # B2C payment aggregates. Each item supplies the payment `date` and a `taxSubtotal` list (per-rate amounts and currency; see the shared converter). Other keys are ignored.
    FrEReportB2cPayment[] b2cPayments?;
};

# The details of the delivery associated with this invoice
public type PurchaseInvoiceDelivery record {
    # The actual delivery date
    @jsondata:Name {value: "actual_date"}
    string actualDate?;
    # The location the goods/services were delivered to
    Location location?;
    # The party the goods/services were delivered to
    PurchaseInvoiceParty party?;
};

# DEPRECATED - Use the new payment_means_array array
public type PaymentMeansDEPRECATED record {
    # The IBAN to which to transfer
    string iban?;
    # An id to mention in the transfer
    string id?;
};

# DEPRECATED - use tax. The VAT details for the invoice line
public type VATDetails record {
    # The ISO 3166 country of the VAT for the invoice line
    string country?;
    # The amount of VAT for the invoice line
    decimal amount?;
    # The percentage of VAT for the invoice line
    decimal percentage?;
};

public type InvoiceSubmissionActionEvidence record {
    # The response the receiver sent
    @jsondata:Name {value: "receiver_response"}
    string receiverResponse?;
    # The document that was transmitted
    @jsondata:Name {value: "transmitted_document"}
    string transmittedDocument?;
    # How the document was transmitted. Matches the sending application name (for example pl-ksef for Poland KSeF)
    @jsondata:Name {value: "transmission_type"}
    "ae-fta"|"as2"|"bpc"|"ch-qrbill"|"edi"|"email"|"es-aeat-verifactu"|"exact_worker"|"finvoice"|"fr-dgfip"|"fr-dgfip-cdar"|"india"|"india-b2c"|"italy-aruba"|"my-lhdnm"|"peppol"|"pl-ksef"|"pt-b2b"|"ro-arxia-anaf"|"sa"|"sandbox"|"sg-iras"|"snelstart_worker"|"spain-face"|"spain-faceb2b"|"svefaktura"|"vatcalc" transmissionType?;
    # The result of this transmission
    @jsondata:Name {value: "transmission_result"}
    "unknown"|"accepted"|"rejected"|"send_error"|"internal_error"|"no_clearing_status"|"pending_clearance"|"sent_pending_confirmation"|"cleared"|"not_clearable"|"clearing_transport_error" transmissionResult?;
    # The DateTime of the transmission, as defined by RFC 3339, section 5.6, for example, 2017-07-21T17:32:28Z
    @jsondata:Name {value: "transmission_datetime"}
    string transmissionDatetime?;
};

public type ReaRegistration record {
    # The identifier
    @constraint:String {maxLength: 20, minLength: 2}
    string identifier?;
    # The captial for the company
    decimal capital?;
    # The provincia of the ufficio that issued the identifier
    "AG"|"AL"|"AN"|"AO"|"AQ"|"AR"|"AP"|"AT"|"AV"|"BA"|"BT"|"BL"|"BN"|"BG"|"BI"|"BO"|"BZ"|"BS"|"BR"|"CA"|"CL"|"CB"|"CI"|"CE"|"CT"|"CZ"|"CH"|"CO"|"CS"|"CR"|"KR"|"CN"|"EN"|"FM"|"FE"|"FI"|"FG"|"FC"|"FR"|"GE"|"GO"|"GR"|"IM"|"IS"|"SP"|"LT"|"LE"|"LC"|"LI"|"LO"|"LU"|"MC"|"MN"|"MS"|"MT"|"VS"|"ME"|"MI"|"MO"|"MB"|"NA"|"NO"|"NU"|"OG"|"OT"|"OR"|"PD"|"PA"|"PR"|"PV"|"PG"|"PU"|"PE"|"PC"|"PI"|"PT"|"PN"|"PZ"|"PO"|"RG"|"RA"|"RC"|"RE"|"RI"|"RN"|"RO"|"SA"|"SS"|"SV"|"SI"|"SR"|"SO"|"TA"|"TE"|"TR"|"TO"|"TP"|"TN"|"TV"|"TS"|"UD"|"VA"|"VE"|"VB"|"VC"|"VR"|"VV"|"VI"|"VT" province?;
    # The number of partners
    "SU"|"SM" partners?;
    # The liquidation status of the company
    @jsondata:Name {value: "liquidation_status"}
    "LN"|"LS" liquidationStatus?;
};

public type PurchaseInvoiceInvoiceLineAllowanceCharge record {
    # The reason for the allowance or charge
    string reason?;
    # The amount of the allowance or charge
    decimal amount?;
};

# The response to a C5 redirect request
public type C5RedirectResponse record {
    # The URL to redirect to
    @jsondata:Name {value: "redirect_url"}
    string redirectUrl;
};

public type Delivery record {
    # The actual date of the delivery. Used only for Invoice
    @constraint:String {pattern: re `^[0-9]{4}-[0-9]{2}-[0-9]{2}$`}
    string actualDeliveryDate?;
    # The quantity of the delivery. Used only for Invoice
    decimal quantity?;
    Shipment shipment?;
    DeliveryDeliveryLocation deliveryLocation?;
    # The party receiving the shipment
    DeliveryParty deliveryParty?;
    # DEPRECATED. Use the shipment object. A text that the buyer requests to be printed on the packing labels. Used only for DocumentOrder
    @constraint:String {maxLength: 128}
    string shippingMarks?;
    # The requested delivery period. Used only for DocumentOrder. Will also be used for DocumentOrder order lines, if that order line does not specify its own delivery period
    @constraint:String {pattern: re `^[0-9]{4}-[0-9]{2}-[0-9]{2} - [0-9]{4}-[0-9]{2}-[0-9]{2}$`}
    string requestedDeliveryPeriod?;
    # DEPRECATED. Use deliveryParty. The name of the party that took delivery. Used only for Invoice
    string deliveryPartyName?;
};

# A party that can send documents
public type SenderParty record {
    # Contact details for the invoice
    Contact contact?;
};

public type WebhookInstance record {
    # The GUID of the WebhookInstance. Use this to delete it
    string guid?;
    # The webhook body that would have been pushed if this were a push-mode webhook
    string body?;
};

# The location the goods/services were delivered to
public type Location record {
    # Address zip code
    string zip?;
    # Address country
    string country?;
    # Address city
    string city?;
    # The scheme id for the id of the location
    @jsondata:Name {value: "scheme_id"}
    string schemeId?;
    # Address county
    string county?;
    # The id of the location
    string id?;
    # The neighborhood. Used in SA
    string neighborhood?;
    # Department name
    string department?;
    # Address line 2
    string line2?;
    # Address line 1
    string line1?;
    # The building number. Used in SA
    @jsondata:Name {value: "building_number"}
    string buildingNumber?;
    # The secondary number. Used in SA
    @jsondata:Name {value: "secondary_number"}
    string secondaryNumber?;
};
